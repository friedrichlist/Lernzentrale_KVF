<script>
const D={"key":"gap2_12_gesundheit_v1","titel":"Prüfungstraining GAP 2 · Teil 1.2 · Gesundheit und Pflege","sparte":"Gesundheit und Pflege","intro":"Hier üben Sie die Leistungsfallbearbeitung in der privaten Kranken- und Pflegeversicherung: Deckung prüfen, Rechnungen nach GOÄ und GOZ abrechnen und Pflegeleistungen berechnen. Rechnen Sie jede Aufgabe schriftlich mit vollständigem Rechenweg, so wie in der Prüfung. Rechtsstand der Pflegeleistungen: 01.01.2026 (Leistungsbeträge des SGB XI seit 01.01.2025). Die Pflegereform 2027 ist noch nicht verabschiedet; tritt sie in Kraft, wird dieser Teil angepasst.","lf":"LF 8","untertitel":"Kaufleute für Versicherungen und Finanzanlagen · GAP 2 Teil 1.2","stand":"10.10.2026","module":[{"nr":"1","titel":"Deckungsprüfung in der privaten Krankenversicherung","abschnitte":[{"nr":"1.1","titel":"Formelle Deckung: Versicherungsbeginn und Wartezeiten","lf":"LF 8","buch":"PV2 8.4 S. 553–592 · Lösungen S. 747–754","lektionen":[{"typ":"wissen","titel":"Grundwissen","items":[{"typ":"mc","frage":"Wann beginnt der Versicherungsschutz in der Krankheitskostenversicherung nach MB/KK 2009?","optionen":["Mit dem im Versicherungsschein genannten Beginn, nicht vor Vertragsschluss und nicht vor Ablauf der Wartezeiten.","Mit dem Tag, an dem der Kunde den Antrag unterschreibt, auch wenn der Versicherer noch nicht angenommen hat.","Mit der Zahlung des ersten Beitrags, unabhängig vom Versicherungsbeginn im Versicherungsschein.","Mit dem ersten Arztbesuch nach Vertragsschluss, weil erst dann ein Versicherungsfall vorliegt."],"richtig":[0],"erkl":"Der Schutz beginnt zum vereinbarten Versicherungsbeginn, jedoch nicht vor Abschluss des Vertrags und nicht vor Ablauf von Wartezeiten. Für Versicherungsfälle vor Beginn des Schutzes wird nicht geleistet.","norm":"§ 2 Abs. 1 MB/KK 2009","id":"1.1-1-1"},{"typ":"mc","frage":"Wie lange dauert die allgemeine Wartezeit in der Krankheitskostenversicherung höchstens?","optionen":["sechs Wochen ab Antragstellung","drei Monate ab Versicherungsbeginn","acht Monate ab Versicherungsbeginn","ein Jahr ab Vertragsschluss"],"richtig":[1],"erkl":"Die allgemeine Wartezeit beträgt drei Monate und rechnet ab Versicherungsbeginn; das VVG begrenzt sie auf diese Dauer.","norm":"§ 3 Abs. 2 MB/KK 2009, § 197 Abs. 1 VVG","id":"1.1-1-2"},{"typ":"wf","frage":"Welche Aussagen zu den besonderen Wartezeiten (acht Monate) treffen zu?","aussagen":[["Sie gelten für Entbindung.",true],["Sie gelten für Psychotherapie.",true],["Sie gelten für Zahnbehandlung, Zahnersatz und Kieferorthopädie.",true],["Sie gelten für jede ambulante Behandlung beim Hausarzt.",false],["Sie gelten für jede stationäre Behandlung im Krankenhaus.",false]],"erkl":"Besondere Wartezeiten von acht Monaten sind nur für Entbindung, Psychotherapie, Zahnbehandlung, Zahnersatz und Kieferorthopädie zulässig. Für die übrigen Leistungen gilt nur die allgemeine Wartezeit.","norm":"§ 3 Abs. 3 MB/KK 2009, § 197 Abs. 1 VVG","id":"1.1-1-3"},{"typ":"mc","frage":"In welchem Fall entfällt die allgemeine Wartezeit nach MB/KK 2009?","optionen":["bei einer Erkrankung, die der Kunde im Antrag angegeben hat","bei Behandlungen, die weniger als 100 Euro kosten","bei Versicherungsfällen, die auf einem Unfall beruhen","bei jeder Behandlung durch einen Facharzt"],"richtig":[2],"erkl":"Die allgemeine Wartezeit entfällt bei Unfällen sowie für den Ehegatten oder Lebenspartner einer mindestens drei Monate versicherten Person, wenn die Versicherung innerhalb von zwei Monaten nach der Eheschließung beantragt wird.","norm":"§ 3 Abs. 2 MB/KK 2009","id":"1.1-1-4"},{"typ":"zuo","frage":"Ordnen Sie jedem Prüfschritt der formellen Deckung die passende Frage zu.","paare":[["Vertrag","Besteht für die versicherte Person ein wirksamer Vertrag?"],["Beitrag","Ist der Erst- oder Folgebeitrag rechtzeitig gezahlt?"],["Versicherungsbeginn","Ist der Versicherungsfall nach dem Beginn eingetreten?"],["Wartezeit","Ist die vorgeschriebene Frist seit Beginn abgelaufen?"]],"erkl":"Die formelle Deckung prüft den Vertrag als solchen: Bestand, Beitragszahlung, Beginn und Wartezeiten. Erst danach folgt die materielle Prüfung der Leistung.","norm":"§§ 2, 3 MB/KK 2009, §§ 37, 38 VVG, § 193 Abs. 6 VVG","id":"1.1-1-5"}]},{"typ":"situation","titel":"Prüfungssituation","situation":"Frau Lena Hoffmann (31) aus Halle (Saale) hat zum 01.04.2026 eine Krankheitskostenvollversicherung bei der Proximus Versicherung AG abgeschlossen. Ein Wartezeiterlass wurde nicht vereinbart. Bei Versicherungsbeginn war sie noch nicht schwanger. Im Oktober 2026 reicht sie einen Heil- und Kostenplan über eine Brücke (Zahnersatz) ein. Außerdem fragt sie, ob ihr Baby, das im Januar 2027 zur Welt kommen soll, ohne Gesundheitsprüfung mitversichert werden kann.","items":[{"typ":"mc","frage":"Wie entscheiden Sie über den Zahnersatz, der im Oktober 2026 angefertigt werden soll?","optionen":["Erstattung, weil die allgemeine Wartezeit von drei Monaten am 30.06.2026 abgelaufen ist.","Erstattung, weil Zahnersatz in der Vollversicherung keiner Wartezeit unterliegt.","Keine Erstattung, weil Zahnersatz in der Vollversicherung nie versichert ist.","Keine Erstattung, weil die Wartezeit von acht Monaten erst am 30.11.2026 endet."],"richtig":[3],"erkl":"Für Zahnersatz gilt die besondere Wartezeit von acht Monaten ab Versicherungsbeginn 01.04.2026, also bis 30.11.2026. Eine Behandlung im Oktober fällt noch in die Wartezeit.","norm":"§ 3 Abs. 3 MB/KK 2009","id":"1.1-2-1"},{"typ":"mc","frage":"Unter welcher Voraussetzung kann das Neugeborene ohne Risikozuschläge und Wartezeiten ab Geburt versichert werden?","optionen":["Ein Elternteil ist am Tag der Geburt mindestens drei Monate versichert, Anmeldung bis zwei Monate danach.","Beide Eltern sind am Tag der Geburt mindestens ein Jahr versichert, Anmeldung bis zwölf Monate danach.","Die Mutter beantragt den Schutz vor der Geburt, eine Anmeldung nach der Geburt ist ausgeschlossen.","Das Kind wird binnen einer Woche angemeldet und ärztlich untersucht, egal wie lange die Eltern versichert sind."],"richtig":[0],"erkl":"Die Kindernachversicherung setzt voraus, dass ein Elternteil am Geburtstag mindestens drei Monate versichert ist und das Kind spätestens zwei Monate nach der Geburt rückwirkend angemeldet wird. Frau Hoffmann ist dann über neun Monate versichert.","norm":"§ 198 Abs. 1 VVG, § 2 Abs. 2 MB/KK 2009","id":"1.1-2-2"},{"typ":"mc","frage":"Die Entbindung ist für Januar 2027 geplant. Wie prüfen Sie die Wartezeit für die Entbindungskosten?","optionen":["Die Entbindung ist ab 01.07.2026 versichert, weil nur die allgemeine Wartezeit gilt.","Die Entbindung ist versichert, weil die Wartezeit von acht Monaten am 30.11.2026 endet.","Die Entbindung ist nicht versichert, weil die Schwangerschaft schon bei Beginn bestand.","Die Entbindung ist erst nach einer Wartezeit von zwölf Monaten, also ab April 2027, versichert."],"richtig":[1],"erkl":"Für Entbindung gilt die besondere Wartezeit von acht Monaten. Sie endet am 30.11.2026; eine Entbindung im Januar 2027 ist daher formell gedeckt.","norm":"§ 3 Abs. 3 MB/KK 2009, § 1 Abs. 2 MB/KK 2009","id":"1.1-2-3"}]}]},{"nr":"1.2","titel":"Materielle Deckung und Geltungsbereich","lf":"LF 8","buch":"PV2 8.4 S. 553–592 · Lösungen S. 747–754","lektionen":[{"typ":"wissen","titel":"Grundwissen","items":[{"typ":"mc","frage":"Was ist der Versicherungsfall in der Krankheitskostenversicherung nach MB/KK 2009?","optionen":["jede Behandlung, die die versicherte Person selbst für sinnvoll und nützlich hält","der Abschluss des Vertrags, weil ab dann Leistungen fällig werden","die medizinisch notwendige Heilbehandlung wegen Krankheit oder Unfallfolgen","das erstmalige Auftreten von Krankheitssymptomen, auch ohne Behandlung"],"richtig":[2],"erkl":"Versicherungsfall ist die medizinisch notwendige Heilbehandlung einer versicherten Person wegen Krankheit oder Unfallfolgen. Er beginnt mit der Heilbehandlung und endet, wenn keine Behandlungsbedürftigkeit mehr besteht.","norm":"§ 1 Abs. 2 MB/KK 2009","id":"1.2-1-1"},{"typ":"mc","frage":"Wo besteht nach MB/KK 2009 grundsätzlich Versicherungsschutz?","optionen":["nur in Deutschland und bei Notfällen in den direkten Nachbarländern","in allen Staaten der Europäischen Union, nicht im übrigen Europa","weltweit ohne zeitliche Grenze, sofern der Wohnsitz in Deutschland liegt","in Europa, außerhalb im ersten Monat eines vorübergehenden Aufenthalts"],"richtig":[3],"erkl":"Der Schutz gilt für Heilbehandlung in Europa. Bei einem vorübergehenden Aufenthalt im außereuropäischen Ausland besteht im ersten Monat auch ohne besondere Vereinbarung Schutz.","norm":"§ 1 Abs. 4 MB/KK 2009","id":"1.2-1-2"},{"typ":"wf","frage":"Welche Aussagen zu den Einschränkungen der Leistungspflicht nach MB/KK 2009 treffen zu?","aussagen":[["Für vorsätzlich herbeigeführte Krankheiten und deren Folgen besteht keine Leistungspflicht.",true],["Bei einer Behandlung durch den Ehegatten werden nur die nachgewiesenen Sachkosten erstattet.",true],["Übersteigt eine Behandlung das medizinisch notwendige Maß, kann der Versicherer auf einen angemessenen Betrag herabsetzen.",true],["Kur- und Sanatoriumsbehandlungen sind ohne besondere Vereinbarung immer voll versichert.",false]],"erkl":"§ 5 MB/KK 2009 nennt Ausschlüsse und Einschränkungen, u. a. Vorsatz, Behandlung durch Angehörige (nur Sachkosten) und Kurbehandlung. Bei Übermaßbehandlung darf der Versicherer kürzen.","norm":"§ 5 Abs. 1 und 2 MB/KK 2009","id":"1.2-1-3"},{"typ":"zuo","frage":"Ordnen Sie dem Fall die zutreffende Prüfungsebene zu.","paare":[["Der Beitrag für März ist nicht gezahlt, der Kunde ist gemahnt.","formelle Deckung"],["Die Brustvergrößerung erfolgt allein aus ästhetischen Gründen.","materielle Deckung: keine medizinische Notwendigkeit"],["Der Kunde will eine Behandlung in Brasilien nach sechs Wochen Aufenthalt erstattet haben.","Geltungsbereich"],["Der Arzt rechnet den 3,5-fachen Satz ohne Begründung ab.","Leistung der Höhe nach"]],"erkl":"Erst wird formell (Vertrag, Beitrag, Beginn, Wartezeit) geprüft, dann materiell (Versicherungsfall, Tarif, Ausschlüsse), dazu der Geltungsbereich; zuletzt wird die Höhe berechnet.","norm":"§§ 1, 5 MB/KK 2009, § 12 Abs. 3 GOÄ","id":"1.2-1-4"},{"typ":"mc","frage":"Welche Behandlungsmethoden sind nach MB/KK 2009 erstattungsfähig?","optionen":["Methoden der Schulmedizin und solche, die sich in der Praxis als ebenso erfolgversprechend bewährt haben","nur Methoden, die die gesetzliche Krankenversicherung in ihren Leistungskatalog aufgenommen hat","alle Methoden, die ein Arzt oder Heilpraktiker anbietet, ohne jede Einschränkung","nur Methoden, die der Versicherer vor der Behandlung schriftlich genehmigt hat"],"richtig":[0],"erkl":"Der Versicherer leistet für Methoden der Schulmedizin sowie für Methoden, die sich in der Praxis als ebenso erfolgversprechend bewährt haben oder angewandt werden, wenn keine schulmedizinischen zur Verfügung stehen.","norm":"§ 4 Abs. 6 MB/KK 2009","id":"1.2-1-5"}]},{"typ":"situation","titel":"Prüfungssituation","situation":"Herr Tobias Reuter (45) aus Merseburg ist seit 2019 vollversichert bei der Proximus Versicherung AG (Tarif ohne Auslandserweiterung). Er reiste am 02.02.2026 für einen auf acht Wochen geplanten Urlaub nach Thailand. Am 20.02.2026 erkrankte er an einer schweren Lungenentzündung und lag bis 10.04.2026 im Krankenhaus in Bangkok, weil ihn die Ärzte nicht fliegen ließen. Zusätzlich reicht er eine Rechnung über eine Faltenbehandlung mit Botox aus Spanien vom Januar 2026 ein, die er allein aus ästhetischen Gründen durchführen ließ.","items":[{"typ":"mc","frage":"Besteht für die Krankenhausbehandlung in Bangkok Versicherungsschutz?","optionen":["Nein, weil außerhalb Europas ohne Auslandserweiterung nie Schutz besteht.","Ja, aber nur für die Zeit bis 01.03.2026, danach endet jeder Schutz.","Ja, Eintritt im ersten Monat; Schutz, solange die Rückreise unmöglich ist.","Nein, weil der Urlaub von Anfang an länger als einen Monat geplant war."],"richtig":[2],"erkl":"Im ersten Monat eines vorübergehenden Aufenthalts außerhalb Europas besteht Schutz. Muss der Aufenthalt wegen der Heilbehandlung verlängert werden, besteht Schutz, solange die Rückreise nicht ohne Gefährdung möglich ist, längstens weitere zwei Monate.","norm":"§ 1 Abs. 4 MB/KK 2009","id":"1.2-2-1"},{"typ":"mc","frage":"Wie bewerten Sie die Faltenbehandlung in Spanien?","optionen":["Versichert, weil Spanien in Europa liegt und jede Arztbehandlung erstattet wird.","Versichert, weil eine ärztliche Behandlung stets medizinisch notwendig ist.","Nicht versichert, weil Spanien nicht zum Geltungsbereich gehört.","Ort gedeckt, aber ohne Krankheit fehlt die medizinische Notwendigkeit."],"richtig":[3],"erkl":"Spanien liegt in Europa, der Geltungsbereich ist erfüllt. Materiell muss aber eine medizinisch notwendige Heilbehandlung vorliegen; eine rein ästhetische Behandlung ohne Krankheitswert ist nicht gedeckt. Der Versicherer kann einen ärztlichen Befund anfordern.","norm":"§ 1 Abs. 2 und 4 MB/KK 2009, § 192 Abs. 1 VVG","id":"1.2-2-2"},{"typ":"wf","frage":"Welche Unterlagen bzw. Schritte sind zur Prüfung des Falls Bangkok sinnvoll?","aussagen":[["Nachweis von Ausreise- und geplantem Rückreisedatum, etwa Flugtickets",true],["ärztliche Bescheinigung, dass die Rückreise nicht ohne Gefährdung möglich war",true],["Rechnungen mit Diagnose, Behandlungsdaten und Einzelleistungen",true],["Nachweis, dass Herr Reuter vor der Reise eine Reiseimpfung bezahlt hat",false]],"erkl":"Für den Geltungsbereich zählen Beginn des Aufenthalts und Reiseunfähigkeit; für die Höhe braucht der Versicherer prüffähige Rechnungen. Herr Reuter muss die nötigen Auskünfte erteilen.","norm":"§ 1 Abs. 4, § 6 Abs. 1, § 9 Abs. 2 MB/KK 2009","id":"1.2-2-3"}]}]}],"lf":"LF 8"},{"nr":"2","titel":"Leistungsabrechnung","abschnitte":[{"nr":"2.1","titel":"Arzthonorare nach GOÄ","lf":"LF 8","buch":"PV2 8.4 S. 553–592 · Lösungen S. 747–754","lektionen":[{"typ":"wissen","titel":"Grundwissen","items":[{"typ":"mc","frage":"Wie berechnet sich eine Gebühr nach der GOÄ?","optionen":["Gebühr = Punktzahl × Punktwert × Steigerungssatz, gerundet auf volle Cent","Gebühr = Punktzahl × Steigerungssatz, gerundet auf volle Euro","Gebühr = Behandlungsdauer in Minuten × Stundensatz des Arztes","Gebühr = Punktzahl × Punktwert, ein Steigerungssatz ist nicht zulässig"],"richtig":[0],"erkl":"Jede Leistung hat eine Punktzahl. Punktzahl × Punktwert (5,82873 Cent) ergibt den Einfachsatz, der mit dem Steigerungssatz multipliziert und auf Cent gerundet wird.","norm":"§ 5 Abs. 1 GOÄ","id":"2.1-1-1"},{"typ":"zahl","frage":"Die Beratung nach Nr. 1 GOÄ hat 80 Punkte. Berechnen Sie die Gebühr zum 2,3-fachen Satz in Euro.","wert":10.72,"einheit":"€","tol":0.02,"erkl":"80 × 5,82873 Cent = 466,2984 Cent = 4,662984 € (Einfachsatz); × 2,3 = 10,7248632 € ≈ 10,72 €.","norm":"§ 5 Abs. 1 und 2 GOÄ","id":"2.1-1-2"},{"typ":"zuo","frage":"Ordnen Sie jeder Leistungsgruppe den Schwellenwert nach GOÄ zu.","paare":[["persönlich-ärztliche Leistungen, z. B. Beratung, Untersuchung","2,3-fach (Höchstsatz 3,5)"],["medizinisch-technische Leistungen, Abschnitte A, E und O","1,8-fach (Höchstsatz 2,5)"],["Laborleistungen, Abschnitt M","1,15-fach (Höchstsatz 1,3)"]],"erkl":"Bis zum Schwellenwert darf der Arzt ohne besondere Begründung abrechnen. Darüber bis zum Höchstsatz nur mit schriftlicher, verständlicher Begründung.","norm":"§ 5 Abs. 2–4 GOÄ","id":"2.1-1-3"},{"typ":"wf","frage":"Welche Aussagen zur Überschreitung des Schwellenwerts treffen zu?","aussagen":[["Der Arzt muss die Überschreitung in der Rechnung schriftlich, verständlich und nachvollziehbar begründen.",true],["Gründe können besondere Schwierigkeit, Zeitaufwand oder Umstände der Ausführung sein.",true],["Eine Begründung wie „erhöhter Aufwand“ ohne Bezug zum Einzelfall genügt in der Regel nicht.",true],["Mit Begründung darf der Arzt bei persönlichen Leistungen beliebig über den 3,5-fachen Satz gehen.",false],["Eine abweichende Honorarvereinbarung über den Höchstsatz hinaus ist nur vor der Behandlung schriftlich möglich.",true]],"erkl":"Über dem Schwellenwert ist eine einzelfallbezogene Begründung Pflicht; der 3,5-fache Satz ist die Obergrenze. Höher geht es nur mit schriftlicher Vereinbarung vor der Behandlung, die der Versicherer nicht übernehmen muss.","norm":"§ 5 Abs. 2, § 12 Abs. 3, § 2 GOÄ","id":"2.1-1-4"},{"typ":"mc","frage":"Ein Arzt rechnet eine Beratung zum 3,0-fachen Satz ab und schreibt keine Begründung dazu. Wie verhält sich der Versicherer?","optionen":["Er lehnt die gesamte Rechnung ab, weil sie fehlerhaft ist.","Er erstattet bis 2,3-fach; für den Rest kann eine Begründung nachgefordert werden.","Er erstattet den 3,0-fachen Satz, weil dieser unter dem Höchstsatz liegt.","Er kürzt die Gebühr auf den 1,0-fachen Satz als Strafe für den Arzt und den Kunden."],"richtig":[1],"erkl":"Ohne Begründung ist die Gebühr über dem Schwellenwert nicht fällig. Der Versicherer erstattet bis 2,3-fach; der Kunde kann beim Arzt eine Begründung nachfordern.","norm":"§ 12 Abs. 3 GOÄ, § 5 Abs. 2 GOÄ","id":"2.1-1-5"}]},{"typ":"situation","titel":"Prüfungssituation","situation":"Herr Kevin Lorenz (38) aus Halle-Neustadt ist bei der Proximus Versicherung AG vollversichert (ambulant 100 %, jährlicher Selbstbehalt 300 €, davon in diesem Jahr bereits 300 € ausgeschöpft). Er reicht eine Rechnung seiner Hausärztin ein: Beratung Nr. 1 (80 Punkte) zum 2,3-fachen Satz, Untersuchung eines Organsystems Nr. 7 (160 Punkte) zum 2,3-fachen Satz, eine technische Leistung aus Abschnitt O (300 Punkte) zum 1,8-fachen Satz sowie zwei Laborleistungen aus Abschnitt M mit 60 und 90 Punkten jeweils zum 1,15-fachen Satz.","items":[{"typ":"zahl","frage":"Berechnen Sie den Rechnungsbetrag in Euro. Runden Sie jede Einzelgebühr auf Cent.","wert":73.7,"einheit":"€","tol":0.02,"erkl":"Nr. 1: 80 × 0,0582873 × 2,3 = 10,72 €; Nr. 7: 160 × 0,0582873 × 2,3 = 21,45 €; technisch: 300 × 0,0582873 × 1,8 = 31,48 €; Labor: 60 × 0,0582873 × 1,15 = 4,02 € und 90 × 0,0582873 × 1,15 = 6,03 €. Summe 73,70 €.","norm":"§ 5 Abs. 1–4 GOÄ","id":"2.1-2-1"},{"typ":"zahl","frage":"Die Ärztin hatte Nr. 1 zunächst zum 3,5-fachen Satz ohne Begründung berechnet. Um wie viel Euro kürzt der Versicherer diese Position?","wert":5.6,"einheit":"€","tol":0.02,"erkl":"3,5-fach: 80 × 0,0582873 × 3,5 = 16,32 €; 2,3-fach: 10,72 €. Kürzung 16,32 € − 10,72 € = 5,60 €.","norm":"§ 12 Abs. 3 GOÄ, § 5 Abs. 2 GOÄ","id":"2.1-2-2"},{"typ":"mc","frage":"Wie erklären Sie Herrn Lorenz die Erstattung der korrigierten Rechnung über 73,70 €?","optionen":["Er erhält 73,70 €, weil sein Selbstbehalt für dieses Jahr bereits ausgeschöpft ist.","Er erhält nichts, weil die Rechnung unter dem Selbstbehalt von 300 € liegt.","Er erhält 80 % der Rechnung, weil Laborleistungen nur anteilig erstattet werden.","Er erhält 73,70 € erst nach Ablauf des Jahres zusammen mit allen anderen Belegen."],"richtig":[0],"erkl":"Der Selbstbehalt wird je Kalenderjahr nur einmal angerechnet. Ist er ausgeschöpft, erstattet der Tarif ambulant 100 % der erstattungsfähigen Kosten.","norm":"§ 4 Abs. 1 MB/KK 2009 i. V. m. Tarif","id":"2.1-2-3"}]}]},{"nr":"2.2","titel":"Zahnarzt und Heilpraktiker","lf":"LF 8","buch":"PV2 8.4 S. 553–592 · Lösungen S. 747–754","lektionen":[{"typ":"wissen","titel":"Grundwissen","items":[{"typ":"mc","frage":"Nach welcher Gebührenordnung rechnen Zahnärzte privatärztliche Leistungen ab?","optionen":["nach der GOÄ mit dem Punktwert 5,82873 Cent","nach dem Gebührenverzeichnis für Heilpraktiker","nach der GOZ mit dem Punktwert 5,62421 Cent","nach freier Vereinbarung ohne Gebührenordnung"],"richtig":[2],"erkl":"Zahnärztliche Leistungen werden nach der GOZ berechnet; der Punktwert beträgt 5,62421 Cent, der Schwellenwert 2,3-fach, der Höchstsatz 3,5-fach.","norm":"§ 5 Abs. 1 und 2 GOZ","id":"2.2-1-1"},{"typ":"zahl","frage":"Eine GOZ-Leistung hat 400 Punkte. Berechnen Sie die Gebühr zum 2,3-fachen Satz in Euro.","wert":51.74,"einheit":"€","tol":0.02,"erkl":"400 × 5,62421 Cent = 22,49684 €; × 2,3 = 51,742732 € ≈ 51,74 €.","norm":"§ 5 Abs. 1 GOZ","id":"2.2-1-2"},{"typ":"mc","frage":"Welche Aussage zum Heilpraktiker trifft zu?","optionen":["Heilpraktiker müssen nach der GOÄ abrechnen, sonst wird nicht erstattet.","Heilpraktiker dürfen nur Leistungen erbringen, die ein Arzt verordnet hat.","Heilpraktikerleistungen sind in jedem PKV-Tarif ohne Grenze versichert.","Das GebüH ist unverbindlich, Tarife erstatten oft bis zu seinen Höchstsätzen."],"richtig":[3],"erkl":"Für Heilpraktiker gibt es keine amtliche Gebührenordnung. Das Gebührenverzeichnis für Heilpraktiker (GebüH) dient als Orientierung; der Tarif legt fest, ob und bis zu welcher Höhe erstattet wird.","norm":"§ 4 Abs. 2 MB/KK 2009 i. V. m. Tarif","id":"2.2-1-3"},{"typ":"wf","frage":"Welche Aussagen zur Abrechnung beim Zahnarzt treffen zu?","aussagen":[["Zahntechnische Laborkosten werden neben den Gebühren gesondert berechnet.",true],["Vor größerem Zahnersatz wird meist ein Heil- und Kostenplan erstellt.",true],["Viele Tarife begrenzen die Zahnleistungen in den ersten Jahren (Zahnstaffel).",true],["Für Zahnersatz gilt in der PKV grundsätzlich keine Wartezeit.",false]],"erkl":"Zahntechnische Laborkosten und Materialien sind gesondert berechnungsfähig. Zahnstaffeln begrenzen die Leistung in den ersten Vertragsjahren; für Zahnersatz gilt die Wartezeit von acht Monaten.","norm":"§ 9 GOZ, § 3 Abs. 3 MB/KK 2009","id":"2.2-1-4"},{"typ":"mc","frage":"Der Versicherer erhält einen Heil- und Kostenplan über 4.800 € für Implantate. Was kann der Kunde verlangen?","optionen":["vorab Auskunft über den Schutz, weil die Kosten über 2.000 € liegen","die sofortige Auszahlung des gesamten Betrags vor der Behandlung auf sein Konto","eine Erstattung ohne spätere Rechnung, weil der Plan schon die Kosten belegt","die Übernahme der Kosten durch die gesetzliche Krankenkasse seines Ehepartners"],"richtig":[0],"erkl":"Bei voraussichtlichen Kosten über 2.000 € kann der Versicherungsnehmer vor Behandlungsbeginn in Textform Auskunft über den Versicherungsschutz verlangen. Bei Dringlichkeit muss sie spätestens nach zwei Wochen, sonst nach vier Wochen erfolgen.","norm":"§ 192 Abs. 8 VVG","id":"2.2-1-5"}]},{"typ":"situation","titel":"Prüfungssituation","situation":"Frau Mandy Krause (52) aus Halle (Saale) ist seit 2018 bei der Proximus Versicherung AG vollversichert. Ihr Tarif erstattet Zahnersatz zu 75 % und Heilpraktikerleistungen zu 80 %, jeweils bis zu den Höchstsätzen der GOZ bzw. des GebüH. Sie reicht eine Zahnarztrechnung über eine Krone ein: Leistung A (1.300 Punkte) und Leistung B (250 Punkte), beide zum 2,3-fachen Satz, Laborkosten 412,50 € und Material 18,00 €. Dazu kommt eine Heilpraktikerrechnung: Position 1 über 45,00 € (GebüH-Höchstsatz 41,00 €) und Position 2 über 30,00 € (GebüH-Höchstsatz 35,00 €).","items":[{"typ":"zahl","frage":"Wie viel Euro erstattet die Proximus für die Zahnarztrechnung?","wert":473.25,"einheit":"€","tol":0.02,"erkl":"A: 1.300 × 0,0562421 × 2,3 = 168,16 €; B: 250 × 0,0562421 × 2,3 = 32,34 €; + Labor 412,50 € + Material 18,00 € = 631,00 €. Erstattung 75 %: 473,25 €.","norm":"§ 5 GOZ, § 9 GOZ, Tarif","id":"2.2-2-1"},{"typ":"zahl","frage":"Wie viel Euro erstattet die Proximus für die Heilpraktikerrechnung?","wert":56.8,"einheit":"€","tol":0.02,"erkl":"Erstattungsfähig je Position höchstens bis GebüH-Höchstsatz: 41,00 € + 30,00 € = 71,00 €. Davon 80 % = 56,80 €.","norm":"§ 4 Abs. 2 MB/KK 2009 i. V. m. Tarif","id":"2.2-2-2"},{"typ":"mc","frage":"Wie erklären Sie Frau Krause die Kürzung bei Position 1 der Heilpraktikerrechnung?","optionen":["Heilpraktikerleistungen sind grundsätzlich nur zur Hälfte versichert.","Der Tarif erstattet nur bis zum GebüH-Höchstsatz, den Rest trägt sie.","Der Heilpraktiker hätte die Leistung nach der GOZ abrechnen müssen.","Die Position ist wegen fehlender Wartezeit nicht versichert."],"richtig":[1],"erkl":"Die Leistungszusage ist tariflich auf die Höchstsätze des GebüH begrenzt. Den darüber liegenden Betrag von 4,00 € schuldet Frau Krause dem Heilpraktiker selbst.","norm":"§ 1 Abs. 3 MB/KK 2009 i. V. m. Tarif","id":"2.2-2-3"}]}]},{"nr":"2.3","titel":"Krankenhaus, Selbstbehalt und mehrere Kostenträger","lf":"LF 8","buch":"PV2 8.4 S. 553–592 · Lösungen S. 747–754","lektionen":[{"typ":"wissen","titel":"Grundwissen","items":[{"typ":"mc","frage":"Welche Leistung gehört zu den allgemeinen Krankenhausleistungen?","optionen":["die Behandlung durch den Chefarzt nach schriftlicher Vereinbarung","die Unterbringung im Einbettzimmer auf Wunsch des Patienten","die Unterbringung im Zweibettzimmer gegen einen täglichen Komfortzuschlag","die notwendige Versorgung im Mehrbettzimmer durch den diensthabenden Arzt"],"richtig":[3],"erkl":"Allgemeine Krankenhausleistungen sind die medizinisch zweckmäßige und ausreichende Versorgung; sie werden über Fallpauschalen (DRG) abgerechnet. Chefarzt und Ein- oder Zweibettzimmer sind Wahlleistungen.","norm":"§ 2 KHEntgG, § 17 KHEntgG","id":"2.3-1-1"},{"typ":"zuo","frage":"Ordnen Sie dem Begriff die passende Beschreibung zu.","paare":[["Wahlleistung Arzt","Behandlung durch liquidationsberechtigte Ärzte, Abrechnung nach GOÄ"],["Minderungspflicht § 6a GOÄ","stationäre privatärztliche Gebühren werden um 25 % gemindert"],["Krankenhaustagegeld","fester Betrag je Tag stationärer Behandlung, frei verwendbar"],["Ersatzkrankenhaustagegeld","Tagessatz, wenn der Patient auf vereinbarte Wahlleistungen verzichtet"]],"erkl":"Wahlleistungen müssen vor der Erbringung schriftlich vereinbart werden. Wahlärzte mindern ihre Gebühren um 25 % (Belegärzte 15 %), weil Sachkosten schon im Pflegesatz stecken.","norm":"§ 17 KHEntgG, § 6a GOÄ","id":"2.3-1-2"},{"typ":"zahl","frage":"Herr Schulz hat einen jährlichen Selbstbehalt von 600 €. Er reicht im Jahr Arztrechnungen über 1.420 € und Arzneimittelrechnungen über 260 € ein (alles erstattungsfähig, Erstattung 100 %). Wie viel Euro erstattet der Versicherer?","wert":1080.0,"einheit":"€","tol":0.02,"erkl":"Erstattungsfähig 1.420 € + 260 € = 1.680 €; abzüglich Selbstbehalt 600 € = 1.080 €.","norm":"Tarif, § 4 MB/KK 2009","id":"2.3-1-3"},{"typ":"mc","frage":"Ein Arbeitnehmer verletzt sich auf dem Weg zur Arbeit und ist privat krankenversichert. Wer leistet vorrangig für die Heilbehandlung?","optionen":["die private Krankenversicherung, weil sie den Vertrag zuerst geschlossen hat","die Berufsgenossenschaft; die PKV zahlt nur, was danach offenbleibt","der Arbeitgeber aus eigenen Mitteln, ohne Beteiligung einer Versicherung","die PKV und die Berufsgenossenschaft je zur Hälfte, egal welche Kosten entstehen"],"richtig":[1],"erkl":"Ein Wegeunfall ist ein Arbeitsunfall. Besteht Anspruch gegen die gesetzliche Unfallversicherung, leistet der PKV-Versicherer nur für Aufwendungen, die trotz der gesetzlichen Leistungen notwendig bleiben.","norm":"§ 5 Abs. 3 MB/KK 2009, § 8 SGB VII","id":"2.3-1-4"},{"typ":"zahl","frage":"Eine Beamtin erhält 50 % Beihilfe. Ihr Beihilfetarif (Restkostenversicherung) erstattet 50 %. Die Arztrechnung beträgt 640,00 €. Wie viel Euro erstattet der PKV-Versicherer?","wert":320.0,"einheit":"€","tol":0.02,"erkl":"Beihilfe 50 % von 640 € = 320 €; Restkostentarif 50 % von 640 € = 320 €. Zusammen 100 %, die Gesamterstattung übersteigt die Aufwendungen nicht.","norm":"§ 5 Abs. 4 MB/KK 2009, Tarif","id":"2.3-1-5"}]},{"typ":"situation","titel":"Prüfungssituation","situation":"Herr Dirk Neumann (58) aus Landsberg bei Halle (Saale) ist bei der Proximus Versicherung AG vollversichert mit Wahlleistungen Chefarzt und Zweibettzimmer (je 100 %). Alternativ zahlt der Tarif ein Ersatzkrankenhaustagegeld von 40 € je Tag. Er lag nach einer Hüftoperation 9 Tage im Krankenhaus. Die Chefarztrechnung weist nach GOÄ 2.480,00 € vor Minderung aus; der Zweibettzimmerzuschlag beträgt 52,00 € je Tag. Sein Tarif hat eine Beitragsrückerstattung von drei Monatsbeiträgen bei Leistungsfreiheit im Kalenderjahr; der Monatsbeitrag beträgt 410 €.","items":[{"typ":"zahl","frage":"Berechnen Sie die Erstattung für Chefarztbehandlung und Zweibettzimmer in Euro.","wert":2328.0,"einheit":"€","tol":0.02,"erkl":"Chefarzt: 2.480,00 € − 25 % (§ 6a GOÄ) = 1.860,00 €; Zweibettzimmer: 9 × 52,00 € = 468,00 €. Erstattung 1.860,00 € + 468,00 € = 2.328,00 €.","norm":"§ 6a GOÄ, § 17 KHEntgG, Tarif","id":"2.3-2-1"},{"typ":"zahl","frage":"Seine Ehefrau ist im selben Tarif versichert, ihr Monatsbeitrag beträgt ebenfalls 410 €. Sie hat im Jahr nur eine Arztrechnung über 280 € und erwartet die Beitragsrückerstattung von drei Monatsbeiträgen. Um wie viel Euro ist es für sie günstiger, die Rechnung selbst zu bezahlen?","wert":950.0,"einheit":"€","tol":0.02,"erkl":"Beitragsrückerstattung 3 × 410 € = 1.230 €. Reicht sie die Rechnung ein, erhält sie 280 € und verliert 1.230 €. Vorteil beim Selbstzahlen: 1.230 € − 280 € = 950 €.","norm":"Tarif (erfolgsabhängige Beitragsrückerstattung)","id":"2.3-2-2"},{"typ":"mc","frage":"Herr Neumann fragt, was er beim nächsten Krankenhausaufenthalt organisatorisch beachten muss. Was empfehlen Sie?","optionen":["Er muss die Krankenhausbehandlung erst mit der Schlussrechnung melden.","Er soll die Krankenhauskosten zuerst bei seiner Rentenversicherung einreichen.","Die Aufnahme binnen 10 Tagen melden und die Klinik-Card vorlegen.","Er darf ohne vorherige Zusage des Versicherers keine Klinik betreten."],"richtig":[2],"erkl":"Jede Krankenhausbehandlung ist binnen zehn Tagen nach Beginn anzuzeigen. Mit der Klinik-Card rechnet das Krankenhaus direkt mit dem Versicherer ab; der Kunde muss nicht in Vorleistung gehen.","norm":"§ 9 Abs. 1 MB/KK 2009","id":"2.3-2-3"}]}]}],"lf":"LF 8"},{"nr":"3","titel":"Pflege, Krankentagegeld und Service","abschnitte":[{"nr":"3.1","titel":"Pflegepflichtversicherung und Pflegeergänzung","lf":"LF 8","buch":"PV2 3.1–3.6 S. 94–155 · Lösungen S. 677–687","lektionen":[{"typ":"wissen","titel":"Grundwissen","items":[{"typ":"mc","frage":"Wer muss eine private Pflegepflichtversicherung abschließen?","optionen":["jede Person, die privat mit Anspruch auf Krankenhausleistungen versichert ist","nur Personen, die bereits einen Pflegegrad haben","alle Personen über 60 Jahre, egal wie sie krankenversichert sind","nur Beamte, weil Angestellte immer in der sozialen Pflegeversicherung sind"],"richtig":[0],"erkl":"Es gilt der Grundsatz „Pflege folgt Krankenversicherung“: Wer privat krankenversichert ist, muss sich privat pflegeversichern. Die Leistungen müssen denen der sozialen Pflegeversicherung gleichwertig sein.","norm":"§ 23 Abs. 1 SGB XI","id":"3.1-1-1"},{"typ":"zuo","frage":"Ordnen Sie jeder Leistungsart der Pflegepflichtversicherung die passende Beschreibung zu.","paare":[["Pflegegeld","Geldbetrag, wenn Angehörige die Pflege zu Hause selbst sicherstellen"],["Pflegesachleistung (PPV: Kostenerstattung)","Kosten für einen ambulanten Pflegedienst bis zum Höchstbetrag"],["Kombinationsleistung","anteilige Sachleistung, der Rest anteilig als Pflegegeld"],["vollstationäre Pflege","pauschaler Betrag für pflegebedingte Aufwendungen im Pflegeheim"]],"erkl":"Die PPV leistet gleichwertig zur sozialen Pflegeversicherung, statt Sachleistungen aber durch Kostenerstattung. Bei der Kombinationsleistung mindert sich das Pflegegeld um den Prozentsatz der genutzten Sachleistung.","norm":"§§ 36–38, 43 SGB XI, MB/PPV","id":"3.1-1-2"},{"typ":"wf","frage":"Welche Aussagen zur Pflegepflichtversicherung treffen zu?","aussagen":[["Die Pflegebedürftigkeit wird in fünf Pflegegrade eingeteilt.",true],["Bei privat Versicherten begutachtet in der Regel MEDICPROOF.",true],["Bei Pflegegrad 1 besteht ein Anspruch auf Pflegegeld wie bei Pflegegrad 2.",false],["Leistungen setzen eine Vorversicherungszeit von zwei Jahren in den letzten zehn Jahren voraus.",true],["Die Beiträge in der PPV richten sich nach dem Einkommen des Versicherten.",false]],"erkl":"Pflegegrad 1 gibt kein Pflegegeld, sondern vor allem den Entlastungsbetrag. Die PPV-Beiträge sind risikogerecht kalkuliert (mit Höchstbeitrag), nicht einkommensabhängig.","norm":"§ 15, § 28a, § 33 Abs. 2 SGB XI, MB/PPV","id":"3.1-1-3"},{"typ":"mc","frage":"Wie unterscheidet sich eine Pflegetagegeldversicherung von einer Pflegekostenversicherung?","optionen":["Das Pflegetagegeld erstattet nur Rechnungen von Pflegediensten nach Vorleistung der PPV.","Das Pflegetagegeld zahlt einen festen Betrag je Tag, frei verwendbar und ohne Kostennachweis.","Die Pflegekostenversicherung zahlt einen festen Betrag je Tag ohne jeden Kostennachweis.","Beide Formen leisten erst, wenn der Pflegebedürftige in ein Heim umzieht."],"richtig":[1],"erkl":"Das Pflegetagegeld ist eine Summenversicherung: Der vereinbarte Tagessatz wird je nach Pflegegrad gezahlt. Die Pflegekostenversicherung erstattet nachgewiesene Restkosten nach Vorleistung der Pflegepflichtversicherung.","norm":"§ 192 Abs. 6 VVG, Tarif","id":"3.1-1-4"},{"typ":"mc","frage":"Welches Merkmal trifft auf die geförderte Pflegezusatzversicherung („Förder-Pflege“) zu?","optionen":["Der Versicherer darf Antragsteller nach einer Gesundheitsprüfung ablehnen.","Die staatliche Zulage beträgt 10 % des Monatsbeitrags ohne Mindestbeitrag.","Es gibt 5 € Zulage monatlich ab 10 € Eigenbeitrag, ohne Gesundheitsprüfung.","Die Förderung gilt nur für Personen ohne gesetzliche Pflegeversicherung."],"richtig":[2],"erkl":"Die Förder-Pflege wird mit 5 € je Monat gefördert, wenn der Eigenbeitrag mindestens 10 € beträgt. Der Versicherer darf niemanden wegen Vorerkrankungen ablehnen; die Wartezeit darf höchstens fünf Jahre betragen.","norm":"§§ 126, 127 SGB XI","id":"3.1-1-5"}]},{"typ":"situation","titel":"Prüfungssituation","situation":"Rechtsstand 01.01.2026 (SGB XI-Leistungen; Pflegereform 2027 noch nicht verabschiedet). Frau Gisela Brandt (79) aus Halle (Saale) ist privat pflegepflichtversichert bei der Proximus Versicherung AG und hat dort zusätzlich einen Pflegetagegeldtarif: 50 € je Tag in Pflegegrad 5; in Pflegegrad 3 werden 60 % davon gezahlt. Sie ist in Pflegegrad 3 eingestuft und wird zu Hause gepflegt. Ein ambulanter Pflegedienst rechnet im Monat 898,20 € ab; der Höchstbetrag für Pflegesachleistungen in Pflegegrad 3 beträgt 1.497 €, das volle Pflegegeld 599 €. Den Rest der Pflege übernimmt ihre Tochter.","items":[{"typ":"zahl","frage":"Wie viel Euro anteiliges Pflegegeld erhält Frau Brandt aus der Pflegepflichtversicherung im Monat (Kombinationsleistung)?","wert":239.6,"einheit":"€","tol":0.02,"erkl":"Genutzte Sachleistung: 898,20 € ÷ 1.497 € = 60 %. Restanspruch Pflegegeld 40 % von 599 € = 239,60 €.","norm":"§ 38 SGB XI, MB/PPV","id":"3.1-2-1"},{"typ":"zahl","frage":"Wie viel Euro zahlt der Pflegetagegeldtarif für einen Monat mit 30 Tagen?","wert":900.0,"einheit":"€","tol":0.02,"erkl":"Tagessatz in Pflegegrad 3: 60 % von 50 € = 30 €; × 30 Tage = 900 €.","norm":"Tarif, § 192 Abs. 6 VVG","id":"3.1-2-2"},{"typ":"mc","frage":"Die Tochter fragt, ob das Pflegetagegeld nachgewiesen verwendet werden muss. Was antworten Sie?","optionen":["Ja, sie muss jeden Monat Belege eines Pflegedienstes einreichen.","Ja, das Geld darf nur für einen Heimplatz verwendet werden.","Nein, das Geld wird aber auf das Pflegegeld der PPV angerechnet.","Nein, es ist frei verwendbar und wird neben der PPV-Leistung gezahlt."],"richtig":[3],"erkl":"Das Pflegetagegeld ist eine Summenversicherung ohne Kostennachweis. Es wird zusätzlich zur Leistung der Pflegepflichtversicherung gezahlt und schließt so die Versorgungslücke.","norm":"§ 192 Abs. 6 VVG, Tarif","id":"3.1-2-3"}]}]},{"nr":"3.2","titel":"Krankentagegeld, Service und Obliegenheiten","lf":"LF 8","buch":"PV2 8.4 S. 553–592 · Lösungen S. 747–754","lektionen":[{"typ":"wissen","titel":"Grundwissen","items":[{"typ":"mc","frage":"Wann liegt Arbeitsunfähigkeit eines Versicherten im Sinne der Krankentagegeldversicherung vor?","optionen":["wenn er seine Tätigkeit nach ärztlichem Befund nur noch teilweise ausüben kann","wenn er den Beruf vorübergehend in keiner Weise ausüben kann und auch nicht ausübt","wenn er nach einer Kündigung länger als sechs Monate keinen neuen Arbeitsplatz findet","wenn der Arzt eine Kur empfiehlt, auch wenn der Versicherte weiterarbeitet"],"richtig":[1],"erkl":"Arbeitsunfähigkeit verlangt, dass der Beruf vorübergehend in keiner Weise ausgeübt werden kann, tatsächlich nicht ausgeübt wird und keine andere Erwerbstätigkeit ausgeübt wird. Teilweise Arbeitsunfähigkeit genügt nicht.","norm":"§ 1 Abs. 3 MB/KT 2009","id":"3.2-1-1"},{"typ":"wf","frage":"Welche Aussagen zur Krankentagegeldversicherung treffen zu?","aussagen":[["Bei Arbeitnehmern beginnt die Leistung meist nach der Lohnfortzahlung, also ab dem 43. Tag.",true],["Das Krankentagegeld darf das Nettoeinkommen aus der beruflichen Tätigkeit nicht übersteigen.",true],["Tritt Berufsunfähigkeit ein, zahlt die Krankentagegeldversicherung unbegrenzt weiter.",false],["Die Zeit ohne Leistung zu Beginn der Arbeitsunfähigkeit heißt Karenzzeit.",true]],"erkl":"Krankentagegeld ersetzt Verdienstausfall und ist auf das Nettoeinkommen begrenzt. Mit Eintritt der Berufsunfähigkeit endet der Vertrag; dafür ist die BU-Versicherung zuständig.","norm":"§ 192 Abs. 5 VVG, MB/KT 2009","id":"3.2-1-2"},{"typ":"zuo","frage":"Ordnen Sie jeder Serviceleistung den passenden Nutzen für den Kunden zu.","paare":[["Leistungs-App","Belege fotografieren und digital zur Erstattung einreichen"],["Klinik-Card","Krankenhaus rechnet direkt mit dem Versicherer ab"],["Kostenauskunft vor Behandlung","Klarheit über die Erstattung vor teuren Eingriffen"],["Gesundheitstelefon","medizinische Beratung und Hilfe bei der Arztsuche"]],"erkl":"Service entlastet den Kunden und senkt Kosten. Die Auskunft vor teuren Behandlungen ist ab voraussichtlich 2.000 € sogar gesetzlich geregelt.","norm":"§ 192 Abs. 8 VVG, § 6 MB/KK 2009","id":"3.2-1-3"},{"typ":"mc","frage":"Welche Obliegenheit hat die versicherte Person nach Eintritt des Versicherungsfalls in der Krankenversicherung?","optionen":["Sie muss sich vor jedem Arztbesuch beim Versicherer abmelden.","Sie muss Auskünfte erteilen und sich vom beauftragten Arzt untersuchen lassen.","Sie muss alle Rechnungen zuerst bei der gesetzlichen Krankenkasse einreichen.","Sie muss den Versicherer innerhalb von 24 Stunden über jede Erkältung informieren."],"richtig":[1],"erkl":"Die versicherte Person muss auf Verlangen jede Auskunft erteilen, die zur Feststellung des Versicherungsfalls und der Leistungspflicht nötig ist, und sich durch einen vom Versicherer beauftragten Arzt untersuchen lassen.","norm":"§ 9 Abs. 2 und 3 MB/KK 2009","id":"3.2-1-4"},{"typ":"mc","frage":"Was ist die mögliche Folge, wenn eine Obliegenheit vorsätzlich verletzt wird?","optionen":["Der Versicherer darf den Beitrag rückwirkend verdoppeln.","Der Versicherer muss trotzdem immer voll leisten.","Der Versicherer darf den Vertrag sofort ohne Frist für alle Familienmitglieder kündigen.","Der Versicherer kann ganz oder teilweise leistungsfrei werden."],"richtig":[3],"erkl":"Bei vorsätzlicher Obliegenheitsverletzung ist der Versicherer leistungsfrei, bei grober Fahrlässigkeit kann er kürzen. Er bleibt leistungspflichtig, soweit die Verletzung für den Versicherungsfall nicht ursächlich war (außer bei Arglist).","norm":"§ 10 MB/KK 2009, § 28 VVG","id":"3.2-1-5"}]},{"typ":"situation","titel":"Prüfungssituation","situation":"Herr Marco Wendt (41) aus Halle (Saale) ist angestellter Elektromeister. Er hat bei der Proximus Versicherung AG ein Krankentagegeld von 120 € je Tag ab dem 43. Tag der Arbeitsunfähigkeit versichert; das liegt unter seinem Nettoeinkommen. Nach einem Bandscheibenvorfall ist er vom 01.03.2026 bis einschließlich 30.04.2026 durchgehend arbeitsunfähig. Er möchte die AU-Bescheinigungen per Leistungs-App einreichen.","items":[{"typ":"zahl","frage":"Wie viel Euro Krankentagegeld zahlt die Proximus für diese Arbeitsunfähigkeit?","wert":2280.0,"einheit":"€","tol":0.02,"erkl":"AU-Dauer: März 31 Tage + April 30 Tage = 61 Tage. Leistung ab Tag 43: 61 − 42 = 19 Tage. 19 × 120 € = 2.280 €.","norm":"MB/KT 2009, Tarif","id":"3.2-2-1"},{"typ":"mc","frage":"Herr Wendt fragt, was gilt, wenn er bei einer künftigen Krankschreibung halbtags von zu Hause aus weiterarbeitet. Was antworten Sie?","optionen":["Er erhält dann die Hälfte des Tagegelds, weil er halbtags arbeitet.","Das hat keine Auswirkung, solange der Arzt ihn weiter krankschreibt.","Der Anspruch entfällt, weil er dann wieder beruflich tätig ist.","Er erhält das doppelte Tagegeld, weil er trotz Krankheit arbeitet."],"richtig":[2],"erkl":"Krankentagegeld setzt voraus, dass der Versicherte seine Tätigkeit tatsächlich nicht ausübt. Arbeitet er teilweise, liegt keine Arbeitsunfähigkeit im Sinne der Bedingungen vor.","norm":"§ 1 Abs. 3 MB/KT 2009","id":"3.2-2-2"},{"typ":"wf","frage":"Welche Hinweise geben Sie Herrn Wendt zur Leistungsabwicklung?","aussagen":[["Er muss die Arbeitsunfähigkeit fristgerecht anzeigen und ärztlich nachweisen.",true],["Er kann die AU-Bescheinigungen digital über die Leistungs-App einreichen.",true],["Ändert sich sein Nettoeinkommen dauerhaft nach unten, muss er dies dem Versicherer melden.",true],["Er braucht keine Nachweise, weil der Arbeitgeber den Versicherer informiert.",false]],"erkl":"Die Arbeitsunfähigkeit ist dem Versicherer anzuzeigen und durch Bescheinigung nachzuweisen. Ein dauerhaft gesunkenes Nettoeinkommen ist mitzuteilen, weil das Tagegeld dieses nicht übersteigen darf.","norm":"§§ 4, 9 MB/KT 2009","id":"3.2-2-3"}]}]}],"lf":"LF 8"}]};
const K=D.key;let S={};try{S=JSON.parse(localStorage.getItem(K)||'{}')}catch(e){S={}}
const save=()=>{try{localStorage.setItem(K,JSON.stringify(S))}catch(e){}};
const heute=()=>{const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')};
// Lerntage: Tage, an denen geübt wurde (für den Prüfungspass), höchstens die letzten 60
function lerntag(){const t=heute(),a=Array.isArray(S._tage)?S._tage.filter(x=>typeof x==='string'&&/^\d{4}-\d\d-\d\d$/.test(x)):[];if(!a.includes(t))a.push(t);a.sort();S._tage=a.slice(-60)}
const online=/^https?:$/.test(location.protocol);
function simStand(){const s=S._sim;return s&&typeof s==='object'&&s.beste&&typeof s.beste.r==='number'?s:null}
const $=s=>document.querySelector(s);const app=$('#app');
$('#brand').innerHTML=D.titel+'<small>'+D.untertitel+'</small>';
const esc=t=>String(t).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function rng(seed){let x=0;for(const c of seed)x=(x*31+c.charCodeAt(0))>>>0;return()=>{x^=x<<13;x>>>=0;x^=x>>17;x^=x<<5;x>>>=0;return x/4294967296}}
function shuf(a,seed){const r=rng(seed),b=a.slice();for(let i=b.length-1;i>0;i--){const j=Math.floor(r()*(i+1));[b[i],b[j]]=[b[j],b[i]]}return b}
function items(arr){return arr.reduce((s,x)=>s+x,0)}
function lekItems(l){return l.items}
function stat(list){const t=list.length;let a=0,r=0;list.forEach(q=>{const s=S[q.id];if(s){a++;if(s.ok)r++}});return{t,a,r,pR:t?Math.round(100*r/t):0,pF:t?Math.round(100*a/t):0}}
const abItems=a=>a.lektionen.flatMap(l=>l.items),modItems=m=>m.abschnitte.flatMap(abItems);
function pills(st){return `<div class="pills"><span class="pill"><span class="dot ${st.pR?'g':''}"></span>${st.pR} % Richtig</span><span class="pill"><span class="dot ${st.pF?'b':''}"></span>${st.pF} % Fortschritt</span></div>`}
function crumb(parts){return '<div class="crumb">'+parts.map(p=>p[1]?`<a data-go="${p[1]}">${esc(p[0])}</a>`:esc(p[0])).join(' › ')+'</div>'}
function home(){const all=D.module.flatMap(modItems),st=stat(all);
 app.innerHTML=`<div class="box"><h1>${esc(D.sparte)} · GAP 2 Teil 1.2</h1><p class="hint">${esc(D.intro)} Jeder Abschnitt hat eine Lektion „Grundwissen“ und eine „Prüfungssituation“. Ihr Fortschritt bleibt nur in diesem Browser gespeichert.</p><div class="bar"><i style="width:${st.pF}%"></i></div>${pills(st)}</div>
 <div class="box">${D.module.map((m,i)=>{const s=stat(modItems(m));return `<div class="card" data-go="m${i}"><div class="ic">${m.nr}</div><div><div class="ct">${m.nr}. ${esc(m.titel)}</div><div class="meta">${m.abschnitte.length} Abschnitte · ${s.t} Seiten · ${esc(m.lf)}</div>${pills(s)}</div></div>`}).join('')}
 <div class="card" data-go="sim"><div class="ic">⏱</div><div><div class="ct">Prüfungssimulation</div><div class="meta">Drei Fälle aus verschiedenen Abschnitten wie in Teil 1.2 der Prüfung, Auswertung je Themenbereich</div>${simKurz()}</div></div></div>`}
function simKurz(){const s=simStand();if(!s)return '<div class="meta" data-sim="leer">Noch keine Simulation abgeschlossen.</div>';const p=x=>Math.round(100*x.r/x.n);return `<div class="pills" data-sim="${s.beste.r}"><span class="pill"><span class="dot g"></span>Bestes Ergebnis ${s.beste.r} von ${s.beste.n} (${p(s.beste)} %)</span><span class="pill"><span class="dot b"></span>Zuletzt ${s.letzte.r} von ${s.letzte.n}</span><span class="pill">${s.anz} ${s.anz===1?'Durchgang':'Durchgänge'}</span></div>`}
function modul(i){const m=D.module[i];app.innerHTML=crumb([['Start','home'],[m.nr+'. '+m.titel]])+`<div class="box"><h1>${m.nr}. ${esc(m.titel)}</h1>${m.abschnitte.map((a,j)=>{const s=stat(abItems(a));return `<div class="card" data-go="a${i}.${j}"><div class="ic">${a.nr}</div><div><div class="ct">${a.nr} ${esc(a.titel)}</div><div class="meta">2 Lektionen · ${s.t} Seiten · ${esc(a.lf)}</div>${pills(s)}</div></div>`}).join('')}</div>`}
function abschnitt(i,j){const m=D.module[i],a=m.abschnitte[j];app.innerHTML=crumb([['Start','home'],[m.nr+'. '+m.titel,'m'+i],[a.nr+' '+a.titel]])+`<div class="box"><h1>${a.nr} ${esc(a.titel)}</h1>${a.lektionen.map((l,k)=>{const s=stat(l.items);return `<div class="card" data-go="l${i}.${j}.${k}"><div class="ic">${k+1}</div><div><div class="ct">Lektion ${k+1}: ${esc(l.titel)}</div><div class="meta">${s.t} Seiten</div>${pills(s)}</div></div>`}).join('')}</div>`}
let P=null; // Spieler
function start(list,ctx){P={list,ctx,pos:0,ans:{},done:{}};show()}
function render(q,seed){let h=`<div class="q">${esc(q.frage)}</div>`;
 if(q.typ==='mc'||q.typ==='mehr'){const ord=shuf(q.optionen.map((_,i)=>i),q.id+seed);if(q.typ==='mehr')h+='<div class="hint">Mehrere Antworten können richtig sein.</div>';
  h+=ord.map(i=>`<label class="opt" data-i="${i}"><input type="${q.typ==='mc'?'radio':'checkbox'}" name="o" value="${i}"><span>${esc(q.optionen[i])}</span></label>`).join('')}
 else if(q.typ==='wf'){h+='<div class="hint">Entscheiden Sie bei jeder Aussage: richtig oder falsch.</div>'+q.aussagen.map((a,i)=>`<div class="wf" data-i="${i}"><span>${esc(a[0])}</span><span class="tg"><button data-v="1">richtig</button><button data-v="0">falsch</button></span></div>`).join('')}
 else if(q.typ==='zuo'){const r=shuf(q.paare.map(p=>p[1]),q.id+seed);h+=q.paare.map((p,i)=>`<div class="zu" data-i="${i}"><b>${esc(p[0])}</b><select><option value="">– bitte wählen –</option>${r.map(x=>`<option>${esc(x)}</option>`).join('')}</select></div>`).join('')}
 else if(q.typ==='zahl'){h+=`<div class="num"><input inputmode="decimal" aria-label="Ergebnis"><span>${esc(q.einheit)}</span></div><div class="hint">Dezimalzahlen mit Komma eingeben, ohne Tausenderpunkt.</div>`}
 return h}
function read(q){const r=app.querySelector('#qa');
 if(q.typ==='mc'||q.typ==='mehr')return[...r.querySelectorAll('input:checked')].map(x=>+x.value);
 if(q.typ==='wf')return[...r.querySelectorAll('.wf')].map(w=>{const b=w.querySelector('button.on');return b?+b.dataset.v:null});
 if(q.typ==='zuo')return[...r.querySelectorAll('.zu select')].map(s=>s.value);
 if(q.typ==='zahl'){const v=r.querySelector('input').value.trim().replace(/\./g,'').replace(',','.');return v===''?null:+v}}
function complete(q,a){if(q.typ==='mc'||q.typ==='mehr')return a.length>0;if(q.typ==='wf')return a.every(x=>x!==null);if(q.typ==='zuo')return a.every(x=>x);return a!==null&&!isNaN(a)}
function check(q,a){if(q.typ==='mc'||q.typ==='mehr'){const s=new Set(a);return s.size===q.richtig.length&&q.richtig.every(x=>s.has(x))}
 if(q.typ==='wf')return q.aussagen.every((x,i)=>(x[1]?1:0)===a[i]);if(q.typ==='zuo')return q.paare.every((p,i)=>p[1]===a[i]);return Math.abs(a-q.wert)<=q.tol+1e-9}
function solution(q){if(q.typ==='mc'||q.typ==='mehr')return'Richtig: '+q.richtig.map(i=>'„'+esc(q.optionen[i])+'“').join(' · ');
 if(q.typ==='zuo')return q.paare.map(p=>esc(p[0])+' → '+esc(p[1])).join('<br>');if(q.typ==='wf')return q.aussagen.map(x=>(x[1]?'✔ richtig: ':'✘ falsch: ')+esc(x[0])).join('<br>');
 return'Ergebnis: '+String(q.wert).replace('.',',')+' '+esc(q.einheit)}
function mark(q,a){const r=app.querySelector('#qa');
 if(q.typ==='mc'||q.typ==='mehr')r.querySelectorAll('.opt').forEach(o=>{const i=+o.dataset.i;if(q.richtig.includes(i))o.classList.add('ok');else if(a.includes(i))o.classList.add('bad')});
 if(q.typ==='wf')r.querySelectorAll('.wf').forEach((w,i)=>w.classList.add((q.aussagen[i][1]?1:0)===a[i]?'ok':'bad'));
 if(q.typ==='zuo')r.querySelectorAll('.zu').forEach((z,i)=>z.classList.add(q.paare[i][1]===a[i]?'ok':'bad'));
 r.querySelectorAll('input,select,button').forEach(x=>x.disabled=true)}
function show(){const q=P.list[P.pos],c=P.ctx,n=P.list.length,sit=c.sit?(c.sit[q.id]||''):'';
 app.innerHTML=crumb(c.crumb)+`<div class="box"><div class="meta">${esc(c.titel)} · Seite ${P.pos+1} von ${n}</div><div class="bar" style="margin:6px 0 4px"><i style="width:${Math.round(100*(P.pos)/n)}%"></i></div>
 ${sit?`<div class="sit"><b>Situation:</b> ${esc(sit)}</div>`:''}<div id="qa">${render(q,c.seed)}</div><div id="fb"></div>
 <div class="nav"><button id="back" ${P.pos?'':'disabled'}>Zurück</button><span><button class="btn-p" id="chk" disabled>Prüfen</button> <button class="btn-p" id="nx" style="display:none">${P.pos+1<n?'Weiter':'Auswertung'}</button></span></div></div>`;
 const qa=$('#qa'),chk=$('#chk');
 const upd=()=>{chk.disabled=!complete(q,read(q))};
 qa.addEventListener('change',upd);qa.addEventListener('input',upd);
 qa.querySelectorAll('.tg button').forEach(b=>b.onclick=()=>{b.parentNode.querySelectorAll('button').forEach(x=>x.classList.remove('on'));b.classList.add('on');upd()});
 $('#back').onclick=()=>{P.pos--;show()};
 const fin=(ok,a)=>{mark(q,a);$('#fb').innerHTML=`<div class="fb ${ok?'ok':'bad'}"><b>${ok?'Richtig!':'Noch nicht ganz.'}</b><div>${ok?'':solution(q)+'<br>'}${esc(q.erkl)}</div>${q.norm?`<div class="norm">Fundstelle: ${esc(q.norm)}</div>`:''}</div>`;chk.style.display='none';$('#nx').style.display=''};
 if(P.done[q.id]!==undefined){restore(q,P.ans[q.id]);fin(P.done[q.id],P.ans[q.id])}
 chk.onclick=()=>{const a=read(q),ok=check(q,a);P.ans[q.id]=a;P.done[q.id]=ok;if(!c.sim){S[q.id]={ok,t:Date.now()};lerntag();save()}fin(ok,a)};
 $('#nx').onclick=()=>{if(P.pos+1<n){P.pos++;show()}else result()}}
function restore(q,a){const r=$('#qa');if(q.typ==='mc'||q.typ==='mehr')r.querySelectorAll('input').forEach(x=>x.checked=a.includes(+x.value));
 if(q.typ==='wf')r.querySelectorAll('.wf').forEach((w,i)=>{const b=w.querySelector(`button[data-v="${a[i]}"]`);if(b)b.classList.add('on')});
 if(q.typ==='zuo')r.querySelectorAll('.zu select').forEach((s,i)=>s.value=a[i]);if(q.typ==='zahl')r.querySelector('input').value=String(a).replace('.',',')}
function result(){const c=P.ctx,ok=P.list.filter(q=>P.done[q.id]).length,n=P.list.length,pct=Math.round(100*ok/n);let extra='';
 if(c.sim){const by={};P.list.forEach(q=>{const b=q.id.split('.')[0];by[b]=by[b]||[0,0];by[b][1]++;if(P.done[q.id])by[b][0]++});
  if(c.zaehlt&&!P.gespeichert){P.gespeichert=true;const s=simStand()||{anz:0,summe:{}},e={r:ok,n,d:heute(),by};
   s.anz=(s.anz|0)+1;s.letzte=e;if(!s.beste||e.r>s.beste.r)s.beste=e;s.summe=s.summe&&typeof s.summe==='object'?s.summe:{};
   Object.keys(by).forEach(b=>{const v=Array.isArray(s.summe[b])?s.summe[b]:[0,0];s.summe[b]=[v[0]+by[b][0],v[1]+by[b][1]]});S._sim=s;lerntag();save()}
  extra='<h2>Ergebnis je Themenbereich</h2>'+Object.keys(by).sort().map(b=>{const m=D.module.find(x=>x.nr===b);const p=Math.round(100*by[b][0]/by[b][1]);return `<div style="margin:8px 0"><div class="meta">${b}. ${esc(m.titel)}: ${by[b][0]} von ${by[b][1]} (${p} %) ${p>=85?'· sicher':p>=60?'· teilweise sicher':'· noch üben'}</div><div class="bar"><i style="width:${p}%"></i></div></div>`}).join('')}
 if(c.sim&&c.zaehlt)extra+=`<p class="hint" data-simgespeichert>Ergebnis gespeichert. Das Wiederholen der Fehler zählt nicht als neue Simulation.</p>`;
 const wrong=P.list.filter(q=>!P.done[q.id]);
 app.innerHTML=crumb(c.crumb)+`<div class="box"><h1>Auswertung</h1><div class="big">${pct} %</div><p>${ok} von ${n} Aufgaben richtig.${pct>=85?' Sehr gut, weiter so!':pct>=60?' Ordentlich – wiederholen Sie die Fehler.':' Arbeiten Sie die Lektion noch einmal durch.'}</p>${extra}
 <div class="nav"><button data-go="${c.back}">Zur Übersicht</button><span>${wrong.length?'<button class="btn-p" id="wr">Fehler wiederholen</button> ':''}<button class="btn-p" id="again">Neu starten</button></span></div></div>`;
 const w=$('#wr');if(w)w.onclick=()=>start(wrong,Object.assign({},c,{seed:c.seed+'f',zaehlt:false}));$('#again').onclick=()=>c.sim?sim():start(c.full||P.list,Object.assign({},c,{seed:c.seed+'n'}))}
function lektion(i,j,k){const m=D.module[i],a=m.abschnitte[j],l=a.lektionen[k],sit={};if(l.situation)l.items.forEach(q=>sit[q.id]=l.situation);
 start(l.items,{titel:`${a.nr} · Lektion ${k+1}: ${l.titel}`,crumb:[['Start','home'],[m.nr+'. '+m.titel,'m'+i],[a.nr+' '+a.titel,'a'+i+'.'+j],['Lektion '+(k+1)]],back:'a'+i+'.'+j,seed:'s',sit,full:l.items})}
function sim(){const L=[];D.module.forEach(m=>m.abschnitte.forEach(a=>a.lektionen.forEach(l=>{if(l.situation)L.push(l)})));
 const seed=String(Date.now()),pick=shuf(L,seed).slice(0,3),sit={},list=[];pick.forEach(l=>l.items.forEach(q=>{list.push(q);sit[q.id]=l.situation}));
 start(list,{titel:'Prüfungssimulation Teil 1.2 · drei Fälle',crumb:[['Start','home'],['Prüfungssimulation']],back:'home',seed,sit,sim:true,zaehlt:true})}
function go(t){$('#menu').classList.remove('on');window.scrollTo(0,0);
 if(t==='home')return home();if(t==='sim')return sim();
 let m;if(m=t.match(/^m(\d+)$/))return modul(+m[1]);if(m=t.match(/^a(\d+)\.(\d+)$/))return abschnitt(+m[1],+m[2]);if(m=t.match(/^l(\d+)\.(\d+)\.(\d+)$/))return lektion(+m[1],+m[2],+m[3])}
document.addEventListener('click',e=>{const g=e.target.closest('[data-go]');if(g){go(g.dataset.go);return}
 const a=e.target.closest('[data-a]');if(a){const v=a.dataset.a;if(v==='theme'){const d=document.documentElement,cur=d.dataset.theme||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');d.dataset.theme=cur==='dark'?'light':'dark';try{localStorage.setItem(K+'_th',d.dataset.theme)}catch(e){}}
 else if(v==='reset'){if(window.confirm('Gesamten Fortschritt einschließlich der Simulationen löschen?')){S={};save();home()}}else go(v);$('#menu').classList.remove('on')}});
$('#mbtn').onclick=()=>$('#menu').classList.toggle('on');
try{const th=localStorage.getItem(K+'_th');if(th)document.documentElement.dataset.theme=th}catch(e){}

// Direktlink von der Startseite (seit 10.10.2026): #bereich-<Nr> öffnet den Prüfungsbereich, #sim die Simulation
function sprung(){const h=decodeURIComponent(location.hash.slice(1));let m;
 if(h==='sim')return sim();
 if(m=h.match(/^bereich-(.+)$/)){const i=D.module.findIndex(x=>String(x.nr)===m[1]);if(i>=0)return modul(i)}
 home()}
window.addEventListener('hashchange',sprung);
sprung();
</script>
</body>
