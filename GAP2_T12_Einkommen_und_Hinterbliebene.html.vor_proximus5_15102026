<script>
const D={"key":"gap2_12_einkommen_v1","titel":"Prüfungstraining GAP 2 · Teil 1.2 · Einkommen und Hinterbliebene","sparte":"Einkommen und Hinterbliebene","intro":"Sie bearbeiten hier Leistungsfälle aus der Unfall-, der Berufsunfähigkeits- und der Lebensversicherung so, wie sie in Teil 1.2 der GAP 2 gefragt werden. Rechnen Sie jede Leistung selbst nach und erklären Sie das Ergebnis so, dass Ihre Kundin oder Ihr Kunde es versteht.","lf":"LF 7","untertitel":"Kaufleute für Versicherungen und Finanzanlagen · GAP 2 Teil 1.2","stand":"10.10.2026","module":[{"nr":"1","titel":"Unfallversicherung im Leistungsfall","abschnitte":[{"nr":"1.1","titel":"Unfallbegriff, Ausschlüsse und Fristen","lf":"LF 7","buch":"PV2 6.1–6.7 S. 285–342 · Lösungen S. 711–720","lektionen":[{"typ":"wissen","titel":"Grundwissen","items":[{"typ":"mc","frage":"Welche Merkmale muss ein Ereignis nach den Musterbedingungen erfüllen, damit ein Unfall vorliegt?","optionen":["plötzlich, von außen auf den Körper wirkend, unfreiwillig, mit Gesundheitsschädigung","plötzlich, durch eigenes Verschulden verursacht, mit dauerhafter Arbeitsunfähigkeit","von außen wirkend, während der Arbeitszeit eingetreten, mit ärztlicher Behandlung","unvorhersehbar, durch einen Dritten verursacht, mit Krankenhausaufenthalt verbunden"],"richtig":[0],"erkl":"Ein Unfall liegt vor, wenn die versicherte Person durch ein plötzlich von außen auf ihren Körper wirkendes Ereignis unfreiwillig eine Gesundheitsschädigung erleidet. Verschulden, Arbeitszeit oder ein Dritter spielen keine Rolle.","norm":"§ 178 Abs. 2 VVG; AUB 2022 (Proximus 5) Ziff. 1.3","id":"1.1-1-1"},{"typ":"wf","frage":"Liegt jeweils ein Unfall im Sinne der Unfallversicherung vor?","aussagen":[["Eine Kundin rutscht auf nassem Laub aus und bricht sich das Handgelenk.",true],["Ein Kunde erleidet beim Fernsehen einen Herzinfarkt.",false],["Ein Kunde wird beim Radfahren in der Freizeit von einem Auto erfasst.",true],["Eine Kundin bekommt nach jahrelanger Bildschirmarbeit eine Sehnenscheidenentzündung.",false]],"erkl":"Herzinfarkt und Verschleiß entstehen von innen bzw. allmählich, es fehlt das plötzlich von außen wirkende Ereignis. Die private Unfallversicherung gilt weltweit und rund um die Uhr, also auch in der Freizeit.","norm":"AUB 2022 (Proximus 5) Ziff. 1.3","id":"1.1-1-2"},{"typ":"mc","frage":"Ein Kunde hebt allein eine schwere Waschmaschine an und reißt sich dabei einen Muskel im Oberarm. Wie ist der Fall zu beurteilen?","optionen":["Nicht versichert, weil kein Ereignis von außen auf den Körper eingewirkt hat.","Versichert: Der erweiterte Unfallbegriff erfasst Muskelrisse durch erhöhte Kraftanstrengung.","Nicht versichert, weil der Kunde die Gefahr durch das Heben selbst verursacht hat.","Versichert nur, wenn der Muskelriss während der beruflichen Tätigkeit eingetreten ist."],"richtig":[1],"erkl":"Nach dem erweiterten Unfallbegriff gilt auch als Unfall, wenn durch erhöhte Kraftanstrengung an Gliedmaßen oder Wirbelsäule ein Gelenk verrenkt oder Muskeln, Sehnen, Bänder oder Kapseln gezerrt oder zerrissen werden.","norm":"AUB 2022 (Proximus 5) Ziff. 1.4","id":"1.1-1-3"},{"typ":"zuo","frage":"Ordnen Sie jedem Fall die zutreffende Beurteilung zu.","paare":[["Ein Kunde stürzt mit 1,9 Promille auf der Treppe.","Ausschluss: Bewusstseinsstörung durch Trunkenheit"],["Ein Kunde verletzt sich bei einem Einbruch, den er selbst begeht.","Ausschluss: vorsätzliche Straftat"],["Ein Kunde reist in ein Land, in dem bereits Krieg herrscht, und wird dort verletzt.","Ausschluss: Kriegsereignis"],["Eine Kundin stürzt infolge eines Unfalls bewusstlos die Böschung hinab.","versichert: Bewusstseinsstörung durch versicherten Unfall"]],"erkl":"Ausgeschlossen sind Unfälle durch Geistes- oder Bewusstseinsstörungen (auch durch Trunkenheit), durch vorsätzliche Straftaten und durch Kriegsereignisse (Ausnahme: überraschend auf einer Auslandsreise, nicht bei Reisen in ein Land, in dem schon Krieg herrscht). Ist die Bewusstseinsstörung selbst Folge eines versicherten Unfalls, besteht Versicherungsschutz.","norm":"AUB 2022 (Proximus 5) Ziff. 5.1","id":"1.1-1-4"},{"typ":"mc","frage":"Innerhalb welcher Frist nach dem Unfall muss die Invalidität nach den Bedingungen der Proximus (AUB 2022) eingetreten sein?","optionen":["innerhalb von 6 Monaten nach dem Unfall","innerhalb von 3 Jahren nach dem Unfall","innerhalb von 24 Monaten nach dem Unfall","innerhalb von 15 Monaten nach dem Unfall"],"richtig":[2],"erkl":"Die Invalidität muss innerhalb von 24 Monaten nach dem Unfall eingetreten und von einem Arzt schriftlich festgestellt sein; geltend machen muss die Kundin sie ebenfalls innerhalb von 24 Monaten. Der Versicherer muss auf diese Fristen hinweisen. (Die GDV-Musterbedingungen nennen 15 Monate – in der Prüfung gilt Proximus.)","norm":"AUB 2022 (Proximus 5) Ziff. 2.1.1.2 und 2.1.1.3; § 186 VVG","id":"1.1-1-5"}]},{"typ":"situation","titel":"Prüfungssituation","situation":"Herr Tobias Rehm (34), Lagerist aus Halle-Neustadt, hat bei der Proximus Versicherung AG eine private Unfallversicherung. Beim Joggen in der Dölauer Heide tritt er in ein Loch, knickt um und reißt sich das Kreuzband. Zwei Tage später ruft er Sie an und fragt, ob das ein Fall für seine Unfallversicherung ist und was er jetzt tun muss.","items":[{"typ":"mc","frage":"Wie beurteilen Sie den Fall dem Grunde nach?","optionen":["Es liegt kein Unfall vor, weil Herr Rehm sich ohne Fremdeinwirkung verletzt hat.","Es liegt kein Unfall vor, weil Sportverletzungen grundsätzlich ausgeschlossen sind.","Es liegt ein Unfall nur vor, wenn Herr Rehm auf dem Weg zur Arbeit war.","Es liegt ein Unfall vor: Das Umknicken im Loch ist ein plötzliches Ereignis von außen."],"richtig":[3],"erkl":"Der unebene Boden wirkt plötzlich von außen auf den Körper; die Verletzung ist unfreiwillig. Freizeitsport ist versichert, eine Fremdeinwirkung ist nicht nötig.","norm":"AUB 2022 (Proximus 5) Ziff. 1.3","id":"1.1-2-1"},{"typ":"mc","frage":"Welche Pflicht nach dem Unfall nennen Sie Herrn Rehm zuerst?","optionen":["unverzüglich einen Arzt hinzuziehen, seine Anordnungen befolgen und den Unfall melden","den Unfall erst melden, wenn feststeht, dass eine dauerhafte Invalidität bleibt","vor jeder ärztlichen Behandlung die Zustimmung des Versicherers einholen","den Unfall bei der Polizei anzeigen und das Protokoll an den Versicherer senden"],"richtig":[0],"erkl":"Nach einem Unfall muss die versicherte Person unverzüglich einen Arzt hinzuziehen, dessen Anordnungen befolgen und den Versicherer unterrichten. Eine Verletzung dieser Obliegenheiten kann den Anspruch gefährden.","norm":"AUB 2022 (Proximus 5) Ziff. 7; § 28 VVG","id":"1.1-2-2"},{"typ":"wf","frage":"Welche Aussagen zur weiteren Bearbeitung des Falls Rehm treffen zu?","aussagen":[["Herr Rehm sollte die Ärzte von der Schweigepflicht entbinden, damit der Versicherer Befunde anfordern kann.",true],["Für eine Invaliditätsleistung muss die Invalidität fristgerecht ärztlich festgestellt und geltend gemacht werden.",true],["Hätte Herr Rehm vor dem Lauf stark getrunken und wäre deshalb gestürzt, könnte ein Ausschluss greifen.",true],["Ein Kreuzbandriss führt immer zu einer Invaliditätsleistung, auch wenn das Knie folgenlos ausheilt.",false]],"erkl":"Invaliditätsleistung gibt es nur bei dauerhafter Beeinträchtigung. Schweigepflichtentbindung und fristgerechte Feststellung sind Voraussetzungen für die Prüfung; Trunkenheit kann als Bewusstseinsstörung ausgeschlossen sein.","norm":"AUB 2022 (Proximus 5) Ziff. 2.1, 5.1 und 7","id":"1.1-2-3"}]}]},{"nr":"1.2","titel":"Invaliditätsleistung: Gliedertaxe, Vorinvalidität, Mitwirkung","lf":"LF 7","buch":"PV2 6.1–6.7 S. 285–342 · Lösungen S. 711–720","lektionen":[{"typ":"wissen","titel":"Grundwissen","items":[{"typ":"zuo","frage":"Ordnen Sie dem vollständigen Verlust bzw. der vollständigen Funktionsunfähigkeit den Invaliditätsgrad nach der Gliedertaxe der Musterbedingungen zu.","paare":[["ein Arm","70 %"],["eine Hand","55 %"],["ein Auge","50 %"],["ein Fuß","40 %"],["das Gehör auf einem Ohr","30 %"]],"erkl":"Die Gliedertaxe legt feste Invaliditätsgrade für Körperteile und Sinnesorgane fest; bei Teilverlust gilt der entsprechende Teil des Prozentsatzes.","norm":"AUB 2022 (Proximus 5) Ziff. 2.1.2.2","id":"1.2-1-1"},{"typ":"mc","frage":"Ein Kunde verliert bei einem Arbeitsunfall den Zeigefinger der rechten Hand vollständig. Welcher Invaliditätsgrad gilt nach der Gliedertaxe?","optionen":["5 %","10 %","20 %","15 %"],"richtig":[1],"erkl":"Die Gliedertaxe sieht für den Zeigefinger 10 % vor; der Daumen hat 20 %, jeder andere Finger 5 %.","norm":"AUB 2022 (Proximus 5) Ziff. 2.1.2.2","id":"1.2-1-2"},{"typ":"zahl","frage":"Frau Okafor hat eine Grundsumme von 80.000 € ohne Progression vereinbart. Nach einem Sturz bleibt die Funktion ihrer linken Hand dauerhaft um 2/5 beeinträchtigt (Hand = 55 %). Berechnen Sie die Invaliditätsleistung in Euro.","wert":17600,"einheit":"€","tol":0.5,"erkl":"Teilverlust anteilig: 55 % × 2/5 = 22 %. Leistung: 22 % × 80.000 € = 17.600 €.","norm":"AUB 2022 (Proximus 5) Ziff. 2.1.2.2","id":"1.2-1-3"},{"typ":"mc","frage":"Ein Unfall beeinträchtigt mehrere Körperteile. Wie wird der Invaliditätsgrad ermittelt?","optionen":["Es zählt nur der höchste Einzelgrad, die übrigen Grade bleiben unberücksichtigt.","Die einzelnen Grade werden addiert und können zusammen auch über 100 % liegen.","Die einzelnen Grade werden addiert, insgesamt aber höchstens mit 100 % angesetzt.","Die Einzelgrade werden gemittelt, damit sich keine überhöhte Leistung ergibt."],"richtig":[2],"erkl":"Sind mehrere Körperteile oder Sinnesorgane betroffen, werden die Invaliditätsgrade zusammengerechnet; mehr als 100 % werden nicht berücksichtigt.","norm":"AUB 2022 (Proximus 5) Ziff. 2.1.2.2","id":"1.2-1-4"},{"typ":"zahl","frage":"Herr Brandt (Grundsumme 100.000 €, ohne Progression) bricht sich den Fuß. Es bleibt eine Funktionsbeeinträchtigung des Fußes von 1/2 (Fuß = 40 %). Laut Gutachten hat eine bestehende Durchblutungsstörung zu 40 % an den Folgen mitgewirkt. Berechnen Sie die Invaliditätsleistung in Euro.","wert":12000,"einheit":"€","tol":0.5,"erkl":"Invaliditätsgrad: 40 % × 1/2 = 20 %. Mitwirkung 40 % (ab 25 % wird gekürzt): 20 % × 60 % = 12 %. Leistung: 12 % × 100.000 € = 12.000 €.","norm":"AUB 2022 (Proximus 5) Ziff. 3.2","id":"1.2-1-5"}]},{"typ":"situation","titel":"Prüfungssituation","situation":"Frau Petra Lindemann (47) aus Halle (Saale) stürzt beim Fensterputzen von der Leiter. Ihr rechtes Auge erblindet vollständig. Laut Augenarzt war die Sehfähigkeit dieses Auges schon vor dem Unfall nachweislich um 1/5 gemindert. Sie hat eine Grundsumme von 80.000 € mit Progression 225 % vereinbart. Progression 225 %: Der Invaliditätsgrad bis 25 % zählt einfach, der Teil über 25 % bis 50 % doppelt, der Teil über 50 % dreifach. Ein Gutachter stellt fest, dass ihr Diabetes zu 20 % an den Unfallfolgen mitgewirkt hat.","items":[{"typ":"zahl","frage":"Ermitteln Sie den maßgeblichen Invaliditätsgrad nach Abzug der Vorinvalidität (in Prozent).","wert":40,"einheit":"%","tol":0.01,"erkl":"Auge = 50 %. Vorinvalidität: 50 % × 1/5 = 10 %. Unfallbedingter Invaliditätsgrad: 50 % − 10 % = 40 %.","norm":"AUB 2022 (Proximus 5) Ziff. 2.1.2.2","id":"1.2-2-1"},{"typ":"mc","frage":"Wie wirkt sich der Diabetes von Frau Lindemann auf die Leistung aus?","optionen":["Die Leistung wird um 20 % gekürzt, weil eine Krankheit an den Folgen mitgewirkt hat.","Die Leistung entfällt ganz, weil Krankheiten vom Versicherungsschutz ausgeschlossen sind.","Der Invaliditätsgrad wird um 20 Prozentpunkte gesenkt, bevor die Progression greift.","Gar nicht, weil der Mitwirkungsanteil unter 25 % liegt und deshalb nicht gekürzt wird."],"richtig":[3],"erkl":"Gekürzt wird nur, wenn Krankheiten oder Gebrechen zu mindestens 25 % mitgewirkt haben. Bei 20 % bleibt der Invaliditätsgrad von 40 % unverändert.","norm":"AUB 2022 (Proximus 5) Ziff. 3.2","id":"1.2-2-2"},{"typ":"zahl","frage":"Berechnen Sie die Invaliditätsleistung für Frau Lindemann in Euro.","wert":44000,"einheit":"€","tol":0.5,"erkl":"Invaliditätsgrad 40 %. Progression 225 %: 25 % × 1 = 25 %; (40 % − 25 %) × 2 = 30 %; zusammen 55 %. Leistung: 55 % × 80.000 € = 44.000 €.","norm":"AUB 2022 (Proximus 5) Ziff. 2.1.2.4 (Progression)","id":"1.2-2-3"}]}]},{"nr":"1.3","titel":"Progression und weitere Leistungsarten","lf":"LF 7","buch":"PV2 6.1–6.7 S. 285–342 · Lösungen S. 711–720","lektionen":[{"typ":"wissen","titel":"Grundwissen","items":[{"typ":"mc","frage":"Welchen Zweck hat eine Progression in der Unfallversicherung?","optionen":["Sie erhöht die Leistung bei hohen Invaliditätsgraden überproportional, weil dort der Bedarf stark steigt.","Sie erhöht die Leistung bei niedrigen Invaliditätsgraden, weil kleine Schäden häufiger vorkommen.","Sie gleicht die Inflation aus, indem die Grundsumme jedes Jahr um einen festen Satz steigt.","Sie senkt den Beitrag, weil bei hohen Invaliditätsgraden weniger als die Grundsumme gezahlt wird."],"richtig":[0],"erkl":"Schwere Invalidität verursacht hohe Kosten (Umbau, Pflege, Einkommensverlust). Die Progression vervielfacht deshalb die Anteile über 25 % bzw. 50 %.","norm":"AUB 2022 (Proximus 5) Ziff. 2.1.2.4 (Progression)","id":"1.3-1-1"},{"typ":"zahl","frage":"Herr Wendt (Grundsumme 100.000 €, Progression 225 %) verliert bei einem Unfall die rechte Hand (55 %) und den Daumen der linken Hand (20 %). Progression 225 %: Der Invaliditätsgrad bis 25 % zählt einfach, der Teil über 25 % bis 50 % doppelt, der Teil über 50 % dreifach. Berechnen Sie die Invaliditätsleistung in Euro.","wert":150000,"einheit":"€","tol":0.5,"erkl":"Invaliditätsgrad: 55 % + 20 % = 75 %. Progression: 25 % × 1 = 25 %; 25 % × 2 = 50 %; 25 % × 3 = 75 %; zusammen 150 %. Leistung: 150 % × 100.000 € = 150.000 €.","norm":"AUB 2022 (Proximus 5) Ziff. 2.1.2.2 und 2.1.2.4 (Progression)","id":"1.3-1-2"},{"typ":"zahl","frage":"Frau Ziegler hat eine Grundsumme von 50.000 € mit Progression 350 %. Progression 350 %: Der Invaliditätsgrad bis 25 % zählt einfach, der Teil über 25 % bis 50 % dreifach, der Teil über 50 % fünffach. Der Invaliditätsgrad beträgt 60 %. Berechnen Sie die Invaliditätsleistung in Euro.","wert":75000,"einheit":"€","tol":0.5,"erkl":"Progression: 25 % × 1 = 25 %; 25 % × 3 = 75 %; 10 % × 5 = 50 %; zusammen 150 %. Leistung: 150 % × 50.000 € = 75.000 €.","norm":"Vertrag (Progression)","id":"1.3-1-3"},{"typ":"mc","frage":"Der Invaliditätsgrad ist noch nicht endgültig absehbar. Bis wann können Versicherer und Versicherungsnehmer ihn jährlich neu bemessen lassen?","optionen":["bis zu einem Jahr nach Eintritt des Unfalls","bis zu drei Jahre nach Eintritt des Unfalls","bis zu fünf Jahre nach Eintritt des Unfalls","bis zum Ende der Vertragslaufzeit"],"richtig":[1],"erkl":"Beide Seiten dürfen den Grad der Invalidität jährlich, längstens bis drei Jahre nach dem Unfall, neu bemessen lassen.","norm":"§ 188 Abs. 1 VVG","id":"1.3-1-4"},{"typ":"wf","frage":"Welche Aussagen zu weiteren Leistungsarten der Unfallversicherung treffen zu?","aussagen":[["Krankenhaustagegeld wird für jeden Tag der unfallbedingten vollstationären Behandlung gezahlt.",true],["Die Todesfallleistung setzt voraus, dass die versicherte Person innerhalb eines Jahres an den Unfallfolgen stirbt.",true],["Ist die Leistung dem Grunde nach klar, aber die Höhe noch offen, kann ein Vorschuss verlangt werden.",true],["Eine vereinbarte Unfallrente wird bei jedem Invaliditätsgrad gezahlt, auch bei 10 %.",false]],"erkl":"Die Unfallrente wird nur ab einem im Vertrag festgelegten Invaliditätsgrad (häufig 50 %) gezahlt. Vorschuss bzw. Abschlagszahlung ist möglich, wenn die Leistungspflicht dem Grunde nach feststeht.","norm":"§ 187 Abs. 2 VVG; AUB 2022 (Proximus 5) Ziff. 2 und 9","id":"1.3-1-5"}]},{"typ":"situation","titel":"Prüfungssituation","situation":"Frau Martina Kessler (39) aus Merseburg wird auf dem Radweg an der Saale von einem E-Scooter gerammt. Folgen: Funktionsbeeinträchtigung des linken Beins (über der Mitte des Oberschenkels, 70 %) zu 3/10 und Minderung der Sehfähigkeit des linken Auges (50 %) zu 1/5. Vertrag: Grundsumme 150.000 €, Progression 225 %, Krankenhaustagegeld 40 € je Tag, Unfallrente ab 50 % Invalidität. Progression 225 %: Der Invaliditätsgrad bis 25 % zählt einfach, der Teil über 25 % bis 50 % doppelt, der Teil über 50 % dreifach. Sie lag 18 Tage vollstationär im Krankenhaus.","items":[{"typ":"zahl","frage":"Berechnen Sie die Invaliditätsleistung für Frau Kessler in Euro.","wert":55500,"einheit":"€","tol":0.5,"erkl":"Bein: 70 % × 3/10 = 21 %; Auge: 50 % × 1/5 = 10 %; zusammen 31 %. Progression: 25 % × 1 = 25 %; 6 % × 2 = 12 %; zusammen 37 %. Leistung: 37 % × 150.000 € = 55.500 €.","norm":"AUB 2022 (Proximus 5) Ziff. 2.1.2.2 und 2.1.2.4 (Progression)","id":"1.3-2-1"},{"typ":"zahl","frage":"Berechnen Sie das Krankenhaustagegeld in Euro.","wert":720,"einheit":"€","tol":0.5,"erkl":"18 Tage × 40 € = 720 €. Die Unfallrente entfällt, weil der Invaliditätsgrad mit 31 % unter 50 % liegt.","norm":"AUB 2022 (Proximus 5) Ziff. 2; Vertrag","id":"1.3-2-2"},{"typ":"mc","frage":"Frau Kessler hat alle Unterlagen zur Invalidität eingereicht. Innerhalb welcher Frist muss die Proximus erklären, ob sie den Anspruch anerkennt?","optionen":["innerhalb von zwei Wochen nach Eingang der Unterlagen","innerhalb von sechs Monaten nach dem Unfalltag","innerhalb von drei Monaten nach Eingang der Unterlagen","innerhalb eines Jahres nach Eingang der Unterlagen"],"richtig":[2],"erkl":"Bei der Invaliditätsleistung beträgt die Erklärungsfrist drei Monate (sonst ein Monat). Nach dem Anerkenntnis ist die Leistung innerhalb von zwei Wochen fällig.","norm":"§ 187 VVG","id":"1.3-2-3"}]}]}],"lf":"LF 7"},{"nr":"2","titel":"Berufsunfähigkeit im Leistungsfall","abschnitte":[{"nr":"2.1","titel":"BU-Begriff, Verweisung und Leistungsprüfung","lf":"LF 7","buch":"PV2 8.6 S. 620–663 · Lösungen S. 758–769","lektionen":[{"typ":"wissen","titel":"Grundwissen","items":[{"typ":"mc","frage":"Wann ist eine versicherte Person nach den üblichen BU-Bedingungen berufsunfähig?","optionen":["wenn sie irgendeinen Beruf auf dem Arbeitsmarkt voraussichtlich weniger als drei Stunden täglich ausüben kann","wenn sie ihren erlernten Beruf voraussichtlich mindestens drei Monate zu mindestens 30 % nicht ausüben kann","wenn sie von ihrem Arzt für mindestens sechs Wochen ununterbrochen arbeitsunfähig geschrieben wurde","wenn sie ihren zuletzt ausgeübten Beruf voraussichtlich mindestens sechs Monate zu mindestens 50 % nicht ausüben kann"],"richtig":[3],"erkl":"Maßgeblich sind der zuletzt ausgeübte Beruf, wie er ohne gesundheitliche Beeinträchtigung ausgestaltet war, ein Grad von mindestens 50 % und eine Prognose von mindestens sechs Monaten. Arbeitsunfähigkeit ist etwas anderes.","norm":"§ 172 Abs. 2 VVG; BU-Musterbedingungen","id":"2.1-1-1"},{"typ":"zuo","frage":"Ordnen Sie jedem Begriff die passende Beschreibung zu.","paare":[["abstrakte Verweisung","Verweis auf einen anderen zumutbaren Beruf, auch wenn die Person ihn nicht ausübt"],["konkrete Verweisung","Verweis auf einen anderen Beruf, den die Person tatsächlich ausübt"],["Verzicht auf abstrakte Verweisung","geprüft wird der zuletzt ausgeübte Beruf, solange kein anderer ausgeübt wird"],["Lebensstellung","Grenze der Verweisung: Einkommen und Ansehen dürfen nicht spürbar sinken"]],"erkl":"Eine Verweisung ist nur auf eine Tätigkeit zulässig, die Ausbildung und Fähigkeiten entspricht und die bisherige Lebensstellung wahrt. Moderne Tarife verzichten meist auf die abstrakte Verweisung.","norm":"§ 172 Abs. 3 VVG; BU-Musterbedingungen","id":"2.1-1-2"},{"typ":"wf","frage":"Welche Unterlagen fordert die Leistungsabteilung bei einem BU-Antrag typischerweise an?","aussagen":[["ausführliche Tätigkeitsbeschreibung des zuletzt ausgeübten Berufs",true],["Berichte der behandelnden Ärzte und eine Schweigepflichtentbindung",true],["Angaben zum Arbeitgeber und zum beruflichen Werdegang",true],["Kontoauszüge der letzten zwölf Monate zum Nachweis der Ausgaben",false]],"erkl":"Für den Leistungsfall braucht der Versicherer Nachweise über Gesundheit (Ärzte) und Beruf (Tätigkeitsbeschreibung, Werdegang). Die privaten Ausgaben sind für die BU-Prüfung unerheblich.","norm":"§ 31 VVG; BU-Musterbedingungen","id":"2.1-1-3"},{"typ":"mc","frage":"Eine Kundin ist seit acht Monaten ununterbrochen zu 60 % außerstande, ihren Beruf auszuüben. Eine Prognose war am Anfang nicht möglich. Was gilt nach den üblichen Bedingungen?","optionen":["Sie gilt als berufsunfähig, weil der Zustand sechs Monate ununterbrochen angedauert hat.","Sie ist nicht berufsunfähig, weil zu Beginn keine Prognose über sechs Monate vorlag.","Sie gilt erst als berufsunfähig, wenn der Zustand zwölf Monate ununterbrochen andauert.","Sie gilt erst als berufsunfähig, wenn zusätzlich eine gesetzliche Rente bewilligt wurde."],"richtig":[0],"erkl":"Ist die versicherte Person sechs Monate ununterbrochen zu mindestens 50 % außerstande, ihren Beruf auszuüben, gilt die Fortdauer dieses Zustands als Berufsunfähigkeit. Viele Tarife leisten dann sogar rückwirkend ab Beginn.","norm":"BU-Musterbedingungen","id":"2.1-1-4"},{"typ":"mc","frage":"Worin unterscheidet sich die gesetzliche Erwerbsminderungsrente von der privaten BU-Rente?","optionen":["Sie stellt auf den zuletzt ausgeübten Beruf ab, gemessen in Prozent der früheren Tätigkeit.","Sie stellt auf jede Tätigkeit des allgemeinen Arbeitsmarkts ab, gemessen in Stunden täglich.","Sie wird ohne Wartezeit an jede Person gezahlt, die in Deutschland gemeldet ist.","Sie wird nur gezahlt, wenn die Erwerbsminderung durch einen Arbeitsunfall verursacht wurde."],"richtig":[1],"erkl":"Volle Erwerbsminderung liegt vor, wenn auf dem allgemeinen Arbeitsmarkt weniger als drei Stunden täglich gearbeitet werden kann, teilweise bei weniger als sechs Stunden. Es gelten Wartezeit und Mindestpflichtbeiträge.","norm":"§ 43 SGB VI","id":"2.1-1-5"}]},{"typ":"situation","titel":"Prüfungssituation","situation":"Herr Marco Schulze (41), Elektroinstallateur bei einem Handwerksbetrieb in Halle (Saale), hat bei der Proximus eine selbstständige BU-Versicherung (Rente 1.500 € monatlich, Beitrag 85 € monatlich, Verzicht auf abstrakte Verweisung). Nach zwei Bandscheibenvorfällen darf er nicht mehr schwer heben und nicht mehr über Kopf arbeiten. Laut Tätigkeitsbeschreibung bestand sein Arbeitstag aus: Montage auf Baustellen 45 %, Kundendienst vor Ort 15 %, Angebote und Abrechnung im Büro 25 %, Materialdisposition im Lager per PC 15 %. Montage und Kundendienst kann er nicht mehr ausüben.","items":[{"typ":"zahl","frage":"Ermitteln Sie den Grad der Berufsunfähigkeit von Herrn Schulze in Prozent.","wert":60,"einheit":"%","tol":0.01,"erkl":"Nicht mehr ausführbar: Montage 45 % + Kundendienst 15 % = 60 %. Die Grenze von 50 % ist überschritten.","norm":"§ 172 Abs. 2 VVG; BU-Musterbedingungen","id":"2.1-2-1"},{"typ":"mc","frage":"Herr Schulze arbeitet zurzeit nicht. Darf die Proximus ihn auf eine Bürotätigkeit als Elektrotechnik-Sachbearbeiter verweisen?","optionen":["Ja, weil er die Bürotätigkeit aufgrund seiner Ausbildung grundsätzlich ausüben könnte.","Ja, weil eine Verweisung immer zulässig ist, wenn das Einkommen nicht unter 50 % sinkt.","Nein, weil auf die abstrakte Verweisung verzichtet wurde und er keinen anderen Beruf ausübt.","Nein, weil eine Verweisung bei Handwerksberufen gesetzlich ausdrücklich verboten ist."],"richtig":[2],"erkl":"Ohne abstrakte Verweisung käme nur eine konkrete Verweisung in Betracht; die setzt voraus, dass Herr Schulze einen anderen Beruf tatsächlich ausübt.","norm":"§ 172 Abs. 3 VVG","id":"2.1-2-2"},{"typ":"wf","frage":"Welche Aussagen zur Leistungsprüfung bei Herrn Schulze treffen zu?","aussagen":[["Die Tätigkeitsbeschreibung muss den Arbeitsalltag vor der Erkrankung realistisch abbilden.",true],["Die Proximus darf ein eigenes ärztliches Gutachten auf ihre Kosten einholen.",true],["Ein Bescheid der Rentenversicherung über Erwerbsminderung ist Voraussetzung für die BU-Rente.",false],["Die Proximus prüft, ob die Beeinträchtigung voraussichtlich mindestens sechs Monate andauert.",true]],"erkl":"Die private BU prüft unabhängig von der gesetzlichen Rentenversicherung. Grundlage sind Tätigkeitsbeschreibung, Arztberichte und gegebenenfalls ein Gutachten.","norm":"§ 172 VVG; BU-Musterbedingungen","id":"2.1-2-3"}]}]},{"nr":"2.2","titel":"Anerkenntnis, Nachprüfung, Leistungsabrechnung und Anzeigepflicht","lf":"LF 7","buch":"PV2 8.6 S. 620–663 · Lösungen S. 758–769","lektionen":[{"typ":"wissen","titel":"Grundwissen","items":[{"typ":"mc","frage":"Was gilt nach dem VVG für ein zeitlich befristetes Anerkenntnis der BU-Leistung?","optionen":["Der Versicherer darf beliebig oft befristet anerkennen, solange er dies begründet.","Der Versicherer darf befristet anerkennen, kann die Leistung aber jederzeit einstellen.","Der Versicherer darf nur unbefristet anerkennen, eine Befristung ist immer unzulässig.","Der Versicherer darf einmalig befristet anerkennen und ist bis zum Fristablauf gebunden."],"richtig":[3],"erkl":"Der Versicherer erklärt nach einem Leistungsantrag in Textform, ob er die Leistungspflicht anerkennt. Ein zeitlich begrenztes Anerkenntnis ist nur einmal zulässig und bis zum Ablauf der Frist bindend.","norm":"§ 173 VVG","id":"2.2-1-1"},{"typ":"mc","frage":"Die Proximus stellt bei einer Nachprüfung fest, dass die Berufsunfähigkeit weggefallen ist. Wann wird sie frühestens leistungsfrei?","optionen":["mit Ablauf des dritten Monats nach Zugang der Mitteilung in Textform","sofort mit dem Tag, an dem das Gutachten erstellt wurde","mit Ablauf des ersten Monats nach Zugang der mündlichen Mitteilung","erst nach Ablauf von zwölf Monaten ab dem Gutachten"],"richtig":[0],"erkl":"Die Leistungsfreiheit nach einer Nachprüfung tritt frühestens mit Ablauf des dritten Monats nach Zugang der Erklärung beim Versicherungsnehmer ein; die Erklärung muss in Textform erfolgen.","norm":"§ 174 VVG","id":"2.2-1-2"},{"typ":"zuo","frage":"Die versicherte Person hat bei Antragstellung eine Erkrankung verschwiegen, nach der in Textform gefragt wurde. Der Versicherer hätte den Vertrag in Kenntnis nur mit einem Ausschluss geschlossen. Ordnen Sie dem Verschulden die Rechtsfolge zu.","paare":[["Arglist","Anfechtung wegen arglistiger Täuschung"],["grobe Fahrlässigkeit","kein Rücktritt; Ausschluss wird rückwirkend Vertragsbestandteil"],["einfache Fahrlässigkeit","keine Kündigung; Ausschluss wird rückwirkend Vertragsbestandteil"],["kein Verschulden","Ausschluss gilt ab der laufenden Versicherungsperiode"]],"erkl":"Hätte der Versicherer zu anderen Bedingungen abgeschlossen, sind Rücktritt (bei grober Fahrlässigkeit) und Kündigung ausgeschlossen; die anderen Bedingungen werden rückwirkend, bei fehlendem Verschulden ab der laufenden Periode Vertragsbestandteil. Bei Arglist kann angefochten werden.","norm":"§§ 19 Abs. 4, 22 VVG; § 123 BGB","id":"2.2-1-3"},{"typ":"wf","frage":"Welche Aussagen zur Leistung im BU-Fall treffen zu?","aussagen":[["Während der Leistung ist die versicherte Person von der Beitragszahlung befreit.",true],["Beiträge, die nach Entstehen des Anspruchs weitergezahlt wurden, werden erstattet.",true],["Eine vereinbarte Beitragsdynamik läuft auch während des Leistungsbezugs weiter.",false],["Eine vereinbarte garantierte Rentensteigerung erhöht die laufende BU-Rente.",true]],"erkl":"Im Leistungsfall entfällt die Beitragspflicht, deshalb endet auch die Beitragsdynamik. Eine Leistungsdynamik (garantierte Rentensteigerung) erhöht dagegen die laufende Rente.","norm":"BU-Musterbedingungen","id":"2.2-1-4"},{"typ":"mc","frage":"Der Versicherer erfährt im Leistungsfall von einer Anzeigepflichtverletzung. Innerhalb welcher Frist muss er seine Rechte nach § 19 VVG ausüben?","optionen":["innerhalb von drei Monaten ab Eintritt des Versicherungsfalls","innerhalb eines Monats ab Kenntnis von der Verletzung","innerhalb eines Jahres ab Kenntnis von der Verletzung","innerhalb von zwei Wochen ab Zugang des Leistungsantrags"],"richtig":[1],"erkl":"Die Rechte müssen innerhalb eines Monats schriftlich geltend gemacht werden; die Frist beginnt mit Kenntnis. Nach fünf Jahren (bei Vorsatz oder Arglist zehn Jahren) seit Vertragsschluss sind sie erloschen.","norm":"§ 21 Abs. 1 und 3 VVG","id":"2.2-1-5"}]},{"typ":"situation","titel":"Prüfungssituation","situation":"Fortsetzung Fall Schulze: Laut Gutachten besteht die Berufsunfähigkeit seit dem 12.03.2026. Nach den Vertragsbedingungen entsteht der Anspruch auf Rente und Beitragsbefreiung mit Ablauf des Monats, in dem die Berufsunfähigkeit eingetreten ist; wird sie später als drei Monate nach Eintritt mitgeteilt, erst mit Beginn des Monats der Mitteilung. Herr Schulze hat die Berufsunfähigkeit am 20.05.2026 gemeldet. Herr Schulze hat die Beiträge (85 € monatlich) bis einschließlich September 2026 weitergezahlt. Die Proximus erkennt die Leistung Ende September 2026 an; ab Oktober zahlt sie laufend. Vereinbart ist eine garantierte Rentensteigerung im Leistungsbezug von 2 % jährlich.","items":[{"typ":"zahl","frage":"Berechnen Sie den Nachzahlungsbetrag (Renten und erstattete Beiträge) für April bis September 2026 in Euro.","wert":9510,"einheit":"€","tol":0.5,"erkl":"Meldung am 20.05.2026, also innerhalb von drei Monaten: Anspruch ab 01.04.2026 (Ablauf März). Renten April bis September: 6 × 1.500 € = 9.000 €. Erstattete Beiträge: 6 × 85 € = 510 €. Nachzahlung: 9.510 €.","norm":"BU-Musterbedingungen; Vertrag","id":"2.2-2-1"},{"typ":"zahl","frage":"Wie hoch ist die monatliche BU-Rente nach der ersten garantierten Rentensteigerung (in Euro)?","wert":1530,"einheit":"€","tol":0.5,"erkl":"1.500 € × 1,02 = 1.530 €.","norm":"Vertrag (Leistungsdynamik)","id":"2.2-2-2"},{"typ":"mc","frage":"Bei der Prüfung fällt auf: Herr Schulze hat im Antrag eine einmalig behandelte Pollenallergie nicht angegeben. Die Proximus hätte den Vertrag auch in Kenntnis unverändert angenommen. Welche Folge hat das?","optionen":["Die Proximus kann zurücktreten, weil jede falsche Angabe im Antrag zum Rücktritt berechtigt.","Die Proximus kann kündigen und muss die bisher gezahlten Beiträge vollständig erstatten.","Keine: Weil der Vertrag unverändert geschlossen worden wäre, bestehen keine Rechte nach § 19 VVG.","Die Proximus kann die BU-Rente um den Anteil kürzen, den die Allergie ausgemacht hätte."],"richtig":[2],"erkl":"Ein Umstand, der den Entschluss des Versicherers nicht beeinflusst hätte, ist nicht gefahrerheblich; Rücktritt und Kündigung scheiden aus. Zudem hat die Allergie mit dem Leistungsfall nichts zu tun.","norm":"§ 19 Abs. 1, 3 und 4, § 21 Abs. 2 VVG","id":"2.2-2-3"}]}]}],"lf":"LF 7"},{"nr":"3","titel":"Hinterbliebenenversorgung und Lebensversicherung im Todesfall","abschnitte":[{"nr":"3.1","titel":"Risikolebensversicherung im Todesfall","lf":"LF 7","buch":"PV2 8.6 S. 620–663 · Lösungen S. 758–769","lektionen":[{"typ":"wissen","titel":"Grundwissen","items":[{"typ":"wf","frage":"Welche Unterlagen benötigt die Leistungsabteilung in der Regel, um eine Todesfallleistung auszuzahlen?","aussagen":[["amtliche Sterbeurkunde",true],["ärztliche Bescheinigung über die Todesursache",true],["Versicherungsschein",true],["Erbschein in jedem Fall, auch wenn eine bezugsberechtigte Person benannt ist",false]],"erkl":"Ist eine Person namentlich bezugsberechtigt, wird kein Erbschein benötigt. Die Todesursache ist wichtig, etwa für die Prüfung der Selbsttötungsklausel.","norm":"§ 31 VVG; AVB Lebensversicherung","id":"3.1-1-1"},{"typ":"mc","frage":"Wann erwirbt eine widerruflich bezugsberechtigte Person das Recht auf die Versicherungsleistung?","optionen":["sofort mit der Benennung, danach kann der VN das Bezugsrecht nicht mehr ändern","erst mit Ablauf der Vertragslaufzeit, auch wenn die versicherte Person vorher stirbt","erst wenn der Erbe zustimmt, dass die Leistung an die benannte Person geht","erst mit Eintritt des Versicherungsfalls; bis dahin kann der VN es jederzeit ändern"],"richtig":[3],"erkl":"Ein widerrufliches Bezugsrecht kann der Versicherungsnehmer bis zum Versicherungsfall ändern; das Recht entsteht erst mit dem Tod. Ein unwiderrufliches Bezugsrecht wirkt sofort.","norm":"§ 159 Abs. 2 und 3 VVG","id":"3.1-1-2"},{"typ":"mc","frage":"Warum fällt die Todesfallleistung an eine benannte bezugsberechtigte Person nicht in den Nachlass?","optionen":["Sie erwirbt den Anspruch unmittelbar aus dem Vertrag zugunsten Dritter, nicht durch Erbfolge.","Sie erwirbt den Anspruch als gesetzliche Erbin und muss ihn mit Miterben teilen.","Sie erwirbt den Anspruch erst, wenn das Nachlassgericht den Erbschein ausgestellt hat.","Sie erwirbt den Anspruch nur, wenn ein Testament die Lebensversicherung ausdrücklich nennt."],"richtig":[0],"erkl":"Die Lebensversicherung mit Bezugsrecht ist ein Vertrag zugunsten Dritter auf den Todesfall. Die Leistung geht an Erben und Nachlassgläubigern vorbei direkt an die bezugsberechtigte Person.","norm":"§§ 328, 331 BGB; § 159 VVG","id":"3.1-1-3"},{"typ":"mc","frage":"Eine versicherte Person nimmt sich zwei Jahre nach Vertragsbeginn vorsätzlich das Leben, ohne dass eine krankhafte Störung der Geistestätigkeit vorlag. Was gilt?","optionen":["Der Versicherer muss die volle Versicherungssumme zahlen, weil der Tod eingetreten ist.","Der Versicherer ist leistungsfrei und zahlt einen vorhandenen Rückkaufswert aus.","Der Versicherer zahlt die halbe Versicherungssumme, weil der Vertrag schon zwei Jahre lief.","Der Versicherer ist leistungsfrei und muss auch keinen Rückkaufswert auszahlen."],"richtig":[1],"erkl":"Bei vorsätzlicher Selbsttötung vor Ablauf von drei Jahren nach Vertragsschluss ist der Versicherer leistungsfrei, außer bei krankhafter Störung der Geistestätigkeit. Er zahlt dann den Rückkaufswert.","norm":"§ 161 Abs. 1 und 3, § 169 VVG","id":"3.1-1-4"},{"typ":"zuo","frage":"Ordnen Sie jeder Vertragsgestaltung das passende Merkmal zu.","paare":[["verbundene Leben","zwei versicherte Personen, Leistung einmal beim ersten Todesfall"],["Überkreuz-Versicherung","jeder Partner ist VN und Bezugsberechtigter auf das Leben des anderen"],["fallende Versicherungssumme","Summe sinkt mit der Restschuld eines Darlehens"],["konstante Versicherungssumme","Summe bleibt über die gesamte Laufzeit gleich"]],"erkl":"Verbundene Leben sind günstig, leisten aber nur einmal. Die Überkreuz-Gestaltung vermeidet Erbschaftsteuer, weil der VN die Leistung aus eigenem Vertrag erhält.","norm":"AVB Lebensversicherung; § 3 Abs. 1 Nr. 4 ErbStG","id":"3.1-1-5"}]},{"typ":"situation","titel":"Prüfungssituation","situation":"Herr Jens Hartwig (39) aus Halle (Saale) stirbt bei einem Verkehrsunfall. Er war Versicherungsnehmer und versicherte Person einer Risikolebensversicherung bei der Proximus über 200.000 €; widerruflich bezugsberechtigt ist seine Lebensgefährtin Anne Vogt. Die beiden waren nicht verheiratet. Laut Testament ist seine Mutter Alleinerbin. Frau Vogt meldet den Todesfall.","items":[{"typ":"mc","frage":"Frau Vogt und die Mutter beanspruchen beide die Leistung. Wer erhält die 200.000 €?","optionen":["die Mutter, weil sie als Alleinerbin den gesamten Nachlass einschließlich Versicherung erbt","beide je zur Hälfte, weil Bezugsrecht und Testament gleichrangig nebeneinander gelten","Frau Vogt, weil sie bezugsberechtigt ist und die Leistung nicht in den Nachlass fällt.","die Mutter, weil ein widerrufliches Bezugsrecht mit dem Tod des VN automatisch erlischt"],"richtig":[2],"erkl":"Mit dem Tod erwirbt die bezugsberechtigte Person den Anspruch unmittelbar. Das Testament betrifft nur den Nachlass, zu dem die Versicherungsleistung nicht gehört.","norm":"§ 159 VVG; §§ 328, 331 BGB","id":"3.1-2-1"},{"typ":"zahl","frage":"Frau Vogt gehört als Lebensgefährtin zur Steuerklasse III und hat einen persönlichen Freibetrag von 20.000 €. Berechnen Sie den steuerpflichtigen Erwerb aus der Todesfallleistung in Euro (ohne weitere Abzüge).","wert":180000,"einheit":"€","tol":0.5,"erkl":"Die Todesfallleistung an die Bezugsberechtigte gilt als Erwerb von Todes wegen. 200.000 € − 20.000 € Freibetrag = 180.000 € steuerpflichtiger Erwerb.","norm":"§ 3 Abs. 1 Nr. 4, §§ 15, 16 ErbStG","id":"3.1-2-2"},{"typ":"mc","frage":"Was muss die Proximus vor bzw. bei der Auszahlung an Frau Vogt gegenüber dem Finanzamt tun?","optionen":["Sie behält die Erbschaftsteuer ein und führt sie an das Finanzamt ab.","Sie muss nichts tun, weil Todesfallleistungen nie erbschaftsteuerpflichtig sind.","Sie wartet mit der Zahlung, bis das Finanzamt die Steuer festgesetzt hat.","Sie zeigt die Auszahlung dem zuständigen Erbschaftsteuer-Finanzamt an."],"richtig":[3],"erkl":"Versicherungsunternehmen müssen Auszahlungen an andere Personen als den VN dem Finanzamt anzeigen. Die Steuer setzt das Finanzamt fest; der Versicherer behält sie nicht ein.","norm":"§ 33 Abs. 3 ErbStG","id":"3.1-2-3"}]}]},{"nr":"3.2","titel":"Gemischte Lebensversicherung im Todesfall und gesetzliche Hinterbliebenenrente","lf":"LF 7","buch":"PV2 8.6 S. 620–663 · Lösungen S. 758–769","lektionen":[{"typ":"wissen","titel":"Grundwissen","items":[{"typ":"mc","frage":"Woraus setzt sich die Todesfallleistung einer gemischten Lebensversicherung in der Regel zusammen?","optionen":["Versicherungssumme plus Überschüsse, ggf. Schlussüberschuss und Bewertungsreserven","nur aus den bisher eingezahlten Beiträgen zuzüglich eines festen Garantiezinses","nur aus dem Rückkaufswert, weil der Vertrag durch den Tod vorzeitig endet","aus der Versicherungssumme abzüglich der noch ausstehenden Beiträge bis zum Ablauf"],"richtig":[0],"erkl":"Im Todesfall wird die vereinbarte Versicherungssumme fällig, dazu kommen die angesammelten Überschüsse sowie gegebenenfalls Schlussüberschuss und Beteiligung an Bewertungsreserven.","norm":"§ 153 VVG; AVB Lebensversicherung","id":"3.2-1-1"},{"typ":"mc","frage":"Ein VN hat als Bezugsberechtigte ohne Namen nur „die Erben“ angegeben. Wie wird die Leistung verteilt?","optionen":["an die Erben zu gleichen Teilen nach Köpfen","an die Erben im Verhältnis ihrer Erbteile","allein an den Ehegatten des Verstorbenen","an den Staat, weil niemand benannt wurde"],"richtig":[1],"erkl":"Sind die Erben ohne nähere Bestimmung bezugsberechtigt, erhalten sie die Leistung im Zweifel nach dem Verhältnis ihrer Erbteile.","norm":"§ 160 Abs. 2 VVG","id":"3.2-1-2"},{"typ":"zuo","frage":"Ordnen Sie jeder gesetzlichen Hinterbliebenenrente den Regelsatz (nach neuem Recht) zu.","paare":[["große Witwenrente","55 % der Versichertenrente"],["kleine Witwenrente","25 % der Versichertenrente"],["Halbwaisenrente","10 % der Versichertenrente"],["Vollwaisenrente","20 % der Versichertenrente"]],"erkl":"Hinzu kommen Zuschläge für Kindererziehung bzw. Waisen. Eigenes Einkommen wird oberhalb eines Freibetrags angerechnet; die kleine Witwenrente ist meist auf 24 Monate begrenzt.","norm":"§§ 46, 48, 67, 97 SGB VI","id":"3.2-1-3"},{"typ":"zahl","frage":"Der verstorbene Ehemann einer Kundin hätte eine Versichertenrente von 1.600 € monatlich erhalten. Berechnen Sie die große Witwenrente nach neuem Recht nach Ablauf des Sterbevierteljahres und vor Einkommensanrechnung in Euro.","wert":880,"einheit":"€","tol":0.5,"erkl":"Große Witwenrente nach neuem Recht: 55 % × 1.600 € = 880 € monatlich (vor Anrechnung eigenen Einkommens). Im Sterbevierteljahr wird die volle Versichertenrente gezahlt.","norm":"§§ 46, 67 SGB VI","id":"3.2-1-4"},{"typ":"wf","frage":"Welche Aussagen zur steuerlichen Behandlung einer Todesfallleistung treffen zu?","aussagen":[["Der Ehegatte hat einen persönlichen Freibetrag von 500.000 €.",true],["Ein Kind hat einen persönlichen Freibetrag von 400.000 €.",true],["Die Todesfallleistung unterliegt bei der Bezugsberechtigten der Einkommensteuer.",false],["Erhält der VN die Leistung aus seinem Vertrag auf das Leben des Partners, fällt keine Erbschaftsteuer an.",true]],"erkl":"Todesfallleistungen sind einkommensteuerfrei, können aber erbschaftsteuerpflichtig sein. Ist der Empfänger selbst VN (Überkreuz), liegt kein Erwerb von Todes wegen vor.","norm":"§§ 3, 16 ErbStG","id":"3.2-1-5"}]},{"typ":"situation","titel":"Prüfungssituation","situation":"Herr Uwe Möller aus Halle (Saale) ist verstorben. Er war VN und versicherte Person einer gemischten Lebensversicherung bei der Proximus; bezugsberechtigt ist seine Ehefrau Sabine Möller (51). Laut Abrechnungsdaten: Versicherungssumme 60.000 €, verzinslich angesammelte Überschüsse 8.340 €, Schlussüberschussanteil 1.150 €, Beteiligung an Bewertungsreserven 210 €. Offen sind ein Policendarlehen über 5.000 € und zwei rückständige Monatsbeiträge zu je 120 €. Das Haushaltsnetto betrug bisher 3.900 €. Künftig hat Frau Möller ihr eigenes Netto von 2.100 € und laut Rentenbescheid eine große Witwenrente von 640 € nach Einkommensanrechnung.","items":[{"typ":"zahl","frage":"Berechnen Sie den Auszahlungsbetrag an Frau Möller in Euro.","wert":64460,"einheit":"€","tol":0.5,"erkl":"60.000 € + 8.340 € + 1.150 € + 210 € = 69.700 €. Abzüglich Policendarlehen 5.000 € und Beitragsrückstand 2 × 120 € = 240 €: 69.700 € − 5.240 € = 64.460 €.","norm":"§ 153 VVG; AVB Lebensversicherung","id":"3.2-2-1"},{"typ":"mc","frage":"Muss Frau Möller auf die Auszahlung Erbschaftsteuer zahlen?","optionen":["Ja, weil Todesfallleistungen an Ehegatten ab 20.000 € immer erbschaftsteuerpflichtig sind.","Ja, weil die Proximus die Steuer bei jeder Auszahlung an Hinterbliebene sofort einbehält.","Nein, weil der Erwerb unter ihrem persönlichen Freibetrag von 500.000 € als Ehegattin liegt.","Nein, weil Lebensversicherungen an Ehegatten grundsätzlich nicht ans Finanzamt gemeldet werden."],"richtig":[2],"erkl":"Die Leistung ist zwar ein Erwerb von Todes wegen, liegt aber weit unter dem Ehegattenfreibetrag von 500.000 €. Die Meldung an das Finanzamt erfolgt trotzdem.","norm":"§§ 3, 16, 33 ErbStG","id":"3.2-2-2"},{"typ":"zahl","frage":"Berechnen Sie die monatliche Einkommenslücke von Frau Möller gegenüber dem bisherigen Haushaltsnetto in Euro.","wert":1160,"einheit":"€","tol":0.5,"erkl":"Künftiges Einkommen: 2.100 € + 640 € = 2.740 €. Lücke: 3.900 € − 2.740 € = 1.160 € monatlich.","norm":"§ 97 SGB VI (Einkommensanrechnung)","id":"3.2-2-3"}]}]}],"lf":"LF 7"}]};
const K=D.key;let S={};try{S=JSON.parse(localStorage.getItem(K)||'{}')}catch(e){S={}}
const save=()=>{try{localStorage.setItem(K,JSON.stringify(S))}catch(e){}};
const heute=()=>{const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')};
// Lerntage: Tage, an denen geübt wurde (für den Prüfungspass), höchstens die letzten 60
function lerntag(){const t=heute(),a=Array.isArray(S._tage)?S._tage.filter(x=>typeof x==='string'&&/^\d{4}-\d\d-\d\d$/.test(x)):[];if(!a.includes(t))a.push(t);a.sort();S._tage=a.slice(-60)}
const online=/^https?:$/.test(location.protocol);
function simStand(){const s=S._sim;return s&&typeof s==='object'&&s.beste&&typeof s.beste.r==='number'?s:null}
const $=s=>document.querySelector(s);const app=$('#app');
$('#brand').innerHTML=D.titel+'<small>'+D.untertitel+'</small>';
const esc=t=>String(t).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function rng(seed){let x=0;for(const c of seed)x=(x*31+c.charCodeAt(0))>>>0;return()=>{x^=x<<13;x>>>=0;x^=x>>17;x^=x<<5;x>>>=0;return x/4294967296}}
function shuf(a,seed){const r=rng(seed),b=a.slice();for(let i=b.length-1;i>0;i--){const j=Math.floor(r()*(i+1));[b[i],b[j]]=[b[j],b[i]]}return b}
function items(arr){return arr.reduce((s,x)=>s+x,0)}
function lekItems(l){return l.items}
function stat(list){const t=list.length;let a=0,r=0;list.forEach(q=>{const s=S[q.id];if(s){a++;if(s.ok)r++}});return{t,a,r,pR:t?Math.round(100*r/t):0,pF:t?Math.round(100*a/t):0}}
const abItems=a=>a.lektionen.flatMap(l=>l.items),modItems=m=>m.abschnitte.flatMap(abItems);
function pills(st){return `<div class="pills"><span class="pill"><span class="dot ${st.pR?'g':''}"></span>${st.pR} % Richtig</span><span class="pill"><span class="dot ${st.pF?'b':''}"></span>${st.pF} % Fortschritt</span></div>`}
function crumb(parts){return '<div class="crumb">'+parts.map(p=>p[1]?`<a data-go="${p[1]}">${esc(p[0])}</a>`:esc(p[0])).join(' › ')+'</div>'}
function home(){const all=D.module.flatMap(modItems),st=stat(all);
 app.innerHTML=`<div class="box"><h1>${esc(D.sparte)} · GAP 2 Teil 1.2</h1><p class="hint">${esc(D.intro)} Jeder Abschnitt hat eine Lektion „Grundwissen“ und eine „Prüfungssituation“. Ihr Fortschritt bleibt nur in diesem Browser gespeichert.</p><div class="bar"><i style="width:${st.pF}%"></i></div>${pills(st)}</div>
 <div class="box">${D.module.map((m,i)=>{const s=stat(modItems(m));return `<div class="card" data-go="m${i}"><div class="ic">${m.nr}</div><div><div class="ct">${m.nr}. ${esc(m.titel)}</div><div class="meta">${m.abschnitte.length} Abschnitte · ${s.t} Seiten · ${esc(m.lf)}</div>${pills(s)}</div></div>`}).join('')}
 <div class="card" data-go="sim"><div class="ic">⏱</div><div><div class="ct">Prüfungssimulation</div><div class="meta">Drei Fälle aus verschiedenen Abschnitten wie in Teil 1.2 der Prüfung, Auswertung je Themenbereich</div>${simKurz()}</div></div></div>`}
function simKurz(){const s=simStand();if(!s)return '<div class="meta" data-sim="leer">Noch keine Simulation abgeschlossen.</div>';const p=x=>Math.round(100*x.r/x.n);return `<div class="pills" data-sim="${s.beste.r}"><span class="pill"><span class="dot g"></span>Bestes Ergebnis ${s.beste.r} von ${s.beste.n} (${p(s.beste)} %)</span><span class="pill"><span class="dot b"></span>Zuletzt ${s.letzte.r} von ${s.letzte.n}</span><span class="pill">${s.anz} ${s.anz===1?'Durchgang':'Durchgänge'}</span></div>`}
function modul(i){const m=D.module[i];app.innerHTML=crumb([['Start','home'],[m.nr+'. '+m.titel]])+`<div class="box"><h1>${m.nr}. ${esc(m.titel)}</h1>${m.abschnitte.map((a,j)=>{const s=stat(abItems(a));return `<div class="card" data-go="a${i}.${j}"><div class="ic">${a.nr}</div><div><div class="ct">${a.nr} ${esc(a.titel)}</div><div class="meta">2 Lektionen · ${s.t} Seiten · ${esc(a.lf)}</div>${pills(s)}</div></div>`}).join('')}</div>`}
function abschnitt(i,j){const m=D.module[i],a=m.abschnitte[j];app.innerHTML=crumb([['Start','home'],[m.nr+'. '+m.titel,'m'+i],[a.nr+' '+a.titel]])+`<div class="box"><h1>${a.nr} ${esc(a.titel)}</h1>${a.lektionen.map((l,k)=>{const s=stat(l.items);return `<div class="card" data-go="l${i}.${j}.${k}"><div class="ic">${k+1}</div><div><div class="ct">Lektion ${k+1}: ${esc(l.titel)}</div><div class="meta">${s.t} Seiten</div>${pills(s)}</div></div>`}).join('')}</div>`}
let P=null; // Spieler
function start(list,ctx){P={list,ctx,pos:0,ans:{},done:{}};show()}
function render(q,seed){let h=`<div class="q">${esc(q.frage)}</div>`;
 if(q.typ==='mc'||q.typ==='mehr'){const ord=shuf(q.optionen.map((_,i)=>i),q.id+seed);if(q.typ==='mehr')h+='<div class="hint">Mehrere Antworten können richtig sein.</div>';
  h+=ord.map(i=>`<label class="opt" data-i="${i}"><input type="${q.typ==='mc'?'radio':'checkbox'}" name="o" value="${i}"><span>${esc(q.optionen[i])}</span></label>`).join('')}
 else if(q.typ==='wf'){h+='<div class="hint">Entscheiden Sie bei jeder Aussage: richtig oder falsch.</div>'+q.aussagen.map((a,i)=>`<div class="wf" data-i="${i}"><span>${esc(a[0])}</span><span class="tg"><button data-v="1">richtig</button><button data-v="0">falsch</button></span></div>`).join('')}
 else if(q.typ==='zuo'){const r=shuf(q.paare.map(p=>p[1]),q.id+seed);h+=q.paare.map((p,i)=>`<div class="zu" data-i="${i}"><b>${esc(p[0])}</b><select><option value="">– bitte wählen –</option>${r.map(x=>`<option>${esc(x)}</option>`).join('')}</select></div>`).join('')}
 else if(q.typ==='zahl'){h+=`<div class="num"><input inputmode="decimal" aria-label="Ergebnis"><span>${esc(q.einheit)}</span></div><div class="hint">Dezimalzahlen mit Komma eingeben, ohne Tausenderpunkt.</div>`}
 return h}
function read(q){const r=app.querySelector('#qa');
 if(q.typ==='mc'||q.typ==='mehr')return[...r.querySelectorAll('input:checked')].map(x=>+x.value);
 if(q.typ==='wf')return[...r.querySelectorAll('.wf')].map(w=>{const b=w.querySelector('button.on');return b?+b.dataset.v:null});
 if(q.typ==='zuo')return[...r.querySelectorAll('.zu select')].map(s=>s.value);
 if(q.typ==='zahl'){const v=r.querySelector('input').value.trim().replace(/\./g,'').replace(',','.');return v===''?null:+v}}
function complete(q,a){if(q.typ==='mc'||q.typ==='mehr')return a.length>0;if(q.typ==='wf')return a.every(x=>x!==null);if(q.typ==='zuo')return a.every(x=>x);return a!==null&&!isNaN(a)}
function check(q,a){if(q.typ==='mc'||q.typ==='mehr'){const s=new Set(a);return s.size===q.richtig.length&&q.richtig.every(x=>s.has(x))}
 if(q.typ==='wf')return q.aussagen.every((x,i)=>(x[1]?1:0)===a[i]);if(q.typ==='zuo')return q.paare.every((p,i)=>p[1]===a[i]);return Math.abs(a-q.wert)<=q.tol+1e-9}
function solution(q){if(q.typ==='mc'||q.typ==='mehr')return'Richtig: '+q.richtig.map(i=>'„'+esc(q.optionen[i])+'“').join(' · ');
 if(q.typ==='zuo')return q.paare.map(p=>esc(p[0])+' → '+esc(p[1])).join('<br>');if(q.typ==='wf')return q.aussagen.map(x=>(x[1]?'✔ richtig: ':'✘ falsch: ')+esc(x[0])).join('<br>');
 return'Ergebnis: '+String(q.wert).replace('.',',')+' '+esc(q.einheit)}
function mark(q,a){const r=app.querySelector('#qa');
 if(q.typ==='mc'||q.typ==='mehr')r.querySelectorAll('.opt').forEach(o=>{const i=+o.dataset.i;if(q.richtig.includes(i))o.classList.add('ok');else if(a.includes(i))o.classList.add('bad')});
 if(q.typ==='wf')r.querySelectorAll('.wf').forEach((w,i)=>w.classList.add((q.aussagen[i][1]?1:0)===a[i]?'ok':'bad'));
 if(q.typ==='zuo')r.querySelectorAll('.zu').forEach((z,i)=>z.classList.add(q.paare[i][1]===a[i]?'ok':'bad'));
 r.querySelectorAll('input,select,button').forEach(x=>x.disabled=true)}
function show(){const q=P.list[P.pos],c=P.ctx,n=P.list.length,sit=c.sit?(c.sit[q.id]||''):'';
 app.innerHTML=crumb(c.crumb)+`<div class="box"><div class="meta">${esc(c.titel)} · Seite ${P.pos+1} von ${n}</div><div class="bar" style="margin:6px 0 4px"><i style="width:${Math.round(100*(P.pos)/n)}%"></i></div>
 ${sit?`<div class="sit"><b>Situation:</b> ${esc(sit)}</div>`:''}<div id="qa">${render(q,c.seed)}</div><div id="fb"></div>
 <div class="nav"><button id="back" ${P.pos?'':'disabled'}>Zurück</button><span><button class="btn-p" id="chk" disabled>Prüfen</button> <button class="btn-p" id="nx" style="display:none">${P.pos+1<n?'Weiter':'Auswertung'}</button></span></div></div>`;
 const qa=$('#qa'),chk=$('#chk');
 const upd=()=>{chk.disabled=!complete(q,read(q))};
 qa.addEventListener('change',upd);qa.addEventListener('input',upd);
 qa.querySelectorAll('.tg button').forEach(b=>b.onclick=()=>{b.parentNode.querySelectorAll('button').forEach(x=>x.classList.remove('on'));b.classList.add('on');upd()});
 $('#back').onclick=()=>{P.pos--;show()};
 const fin=(ok,a)=>{mark(q,a);$('#fb').innerHTML=`<div class="fb ${ok?'ok':'bad'}"><b>${ok?'Richtig!':'Noch nicht ganz.'}</b><div>${ok?'':solution(q)+'<br>'}${esc(q.erkl)}</div>${q.norm?`<div class="norm">Fundstelle: ${esc(q.norm)}</div>`:''}</div>`;chk.style.display='none';$('#nx').style.display=''};
 if(P.done[q.id]!==undefined){restore(q,P.ans[q.id]);fin(P.done[q.id],P.ans[q.id])}
 chk.onclick=()=>{const a=read(q),ok=check(q,a);P.ans[q.id]=a;P.done[q.id]=ok;if(!c.sim){S[q.id]={ok,t:Date.now()};lerntag();save()}fin(ok,a)};
 $('#nx').onclick=()=>{if(P.pos+1<n){P.pos++;show()}else result()}}
function restore(q,a){const r=$('#qa');if(q.typ==='mc'||q.typ==='mehr')r.querySelectorAll('input').forEach(x=>x.checked=a.includes(+x.value));
 if(q.typ==='wf')r.querySelectorAll('.wf').forEach((w,i)=>{const b=w.querySelector(`button[data-v="${a[i]}"]`);if(b)b.classList.add('on')});
 if(q.typ==='zuo')r.querySelectorAll('.zu select').forEach((s,i)=>s.value=a[i]);if(q.typ==='zahl')r.querySelector('input').value=String(a).replace('.',',')}
function result(){const c=P.ctx,ok=P.list.filter(q=>P.done[q.id]).length,n=P.list.length,pct=Math.round(100*ok/n);let extra='';
 if(c.sim){const by={};P.list.forEach(q=>{const b=q.id.split('.')[0];by[b]=by[b]||[0,0];by[b][1]++;if(P.done[q.id])by[b][0]++});
  if(c.zaehlt&&!P.gespeichert){P.gespeichert=true;const s=simStand()||{anz:0,summe:{}},e={r:ok,n,d:heute(),by};
   s.anz=(s.anz|0)+1;s.letzte=e;if(!s.beste||e.r>s.beste.r)s.beste=e;s.summe=s.summe&&typeof s.summe==='object'?s.summe:{};
   Object.keys(by).forEach(b=>{const v=Array.isArray(s.summe[b])?s.summe[b]:[0,0];s.summe[b]=[v[0]+by[b][0],v[1]+by[b][1]]});S._sim=s;lerntag();save()}
  extra='<h2>Ergebnis je Themenbereich</h2>'+Object.keys(by).sort().map(b=>{const m=D.module.find(x=>x.nr===b);const p=Math.round(100*by[b][0]/by[b][1]);return `<div style="margin:8px 0"><div class="meta">${b}. ${esc(m.titel)}: ${by[b][0]} von ${by[b][1]} (${p} %) ${p>=85?'· sicher':p>=60?'· teilweise sicher':'· noch üben'}</div><div class="bar"><i style="width:${p}%"></i></div></div>`}).join('')}
 if(c.sim&&c.zaehlt)extra+=`<p class="hint" data-simgespeichert>Ergebnis gespeichert. Das Wiederholen der Fehler zählt nicht als neue Simulation.</p>`;
 const wrong=P.list.filter(q=>!P.done[q.id]);
 app.innerHTML=crumb(c.crumb)+`<div class="box"><h1>Auswertung</h1><div class="big">${pct} %</div><p>${ok} von ${n} Aufgaben richtig.${pct>=85?' Sehr gut, weiter so!':pct>=60?' Ordentlich – wiederholen Sie die Fehler.':' Arbeiten Sie die Lektion noch einmal durch.'}</p>${extra}
 <div class="nav"><button data-go="${c.back}">Zur Übersicht</button><span>${wrong.length?'<button class="btn-p" id="wr">Fehler wiederholen</button> ':''}<button class="btn-p" id="again">Neu starten</button></span></div></div>`;
 const w=$('#wr');if(w)w.onclick=()=>start(wrong,Object.assign({},c,{seed:c.seed+'f',zaehlt:false}));$('#again').onclick=()=>c.sim?sim():start(c.full||P.list,Object.assign({},c,{seed:c.seed+'n'}))}
function lektion(i,j,k){const m=D.module[i],a=m.abschnitte[j],l=a.lektionen[k],sit={};if(l.situation)l.items.forEach(q=>sit[q.id]=l.situation);
 start(l.items,{titel:`${a.nr} · Lektion ${k+1}: ${l.titel}`,crumb:[['Start','home'],[m.nr+'. '+m.titel,'m'+i],[a.nr+' '+a.titel,'a'+i+'.'+j],['Lektion '+(k+1)]],back:'a'+i+'.'+j,seed:'s',sit,full:l.items})}
function sim(){const L=[];D.module.forEach(m=>m.abschnitte.forEach(a=>a.lektionen.forEach(l=>{if(l.situation)L.push(l)})));
 const seed=String(Date.now()),pick=shuf(L,seed).slice(0,3),sit={},list=[];pick.forEach(l=>l.items.forEach(q=>{list.push(q);sit[q.id]=l.situation}));
 start(list,{titel:'Prüfungssimulation Teil 1.2 · drei Fälle',crumb:[['Start','home'],['Prüfungssimulation']],back:'home',seed,sit,sim:true,zaehlt:true})}
function go(t){$('#menu').classList.remove('on');window.scrollTo(0,0);
 if(t==='home')return home();if(t==='sim')return sim();
 let m;if(m=t.match(/^m(\d+)$/))return modul(+m[1]);if(m=t.match(/^a(\d+)\.(\d+)$/))return abschnitt(+m[1],+m[2]);if(m=t.match(/^l(\d+)\.(\d+)\.(\d+)$/))return lektion(+m[1],+m[2],+m[3])}
document.addEventListener('click',e=>{const g=e.target.closest('[data-go]');if(g){go(g.dataset.go);return}
 const a=e.target.closest('[data-a]');if(a){const v=a.dataset.a;if(v==='theme'){const d=document.documentElement,cur=d.dataset.theme||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');d.dataset.theme=cur==='dark'?'light':'dark';try{localStorage.setItem(K+'_th',d.dataset.theme)}catch(e){}}
 else if(v==='reset'){if(window.confirm('Gesamten Fortschritt einschließlich der Simulationen löschen?')){S={};save();home()}}else go(v);$('#menu').classList.remove('on')}});
$('#mbtn').onclick=()=>$('#menu').classList.toggle('on');
try{const th=localStorage.getItem(K+'_th');if(th)document.documentElement.dataset.theme=th}catch(e){}

// Direktlink von der Startseite (seit 10.10.2026): #bereich-<Nr> öffnet den Prüfungsbereich, #sim die Simulation
function sprung(){const h=decodeURIComponent(location.hash.slice(1));let m;
 if(h==='sim')return sim();
 if(m=h.match(/^bereich-(.+)$/)){const i=D.module.findIndex(x=>String(x.nr)===m[1]);if(i>=0)return modul(i)}
 home()}
window.addEventListener('hashchange',sprung);
sprung();
</script>
</body>
</html>
